PREFIX mnp: <https://yangjunjie-lin.github.io/KG-MNP-Demo/ontology/terms#>

# Sole runtime source of assessment dependency edges.
# Bind ?requestedCaseId via RDFLib initBindings (xsd:string literal).

SELECT DISTINCT ?subject ?predicate ?object
WHERE {
  ?case mnp:caseIdentifier ?caseId ;
        mnp:hasEligibilityAssessment ?assessment .
  FILTER(STR(?caseId) = STR(?requestedCaseId))

  {
    ?case mnp:hasEligibilityAssessment ?assessment .
    BIND(?case AS ?subject)
    BIND(mnp:hasEligibilityAssessment AS ?predicate)
    BIND(?assessment AS ?object)
  }
  UNION
  {
    ?assessment ?predicate ?object .
    FILTER(?predicate IN (
      mnp:aboutCase,
      mnp:usesEvidence,
      mnp:evaluatedByRule,
      mnp:usesRuleVersion,
      mnp:producesDecision,
      mnp:markedForReassessment
    ))
    BIND(?assessment AS ?subject)
  }
  UNION
  {
    ?assessment mnp:producesDecision ?decision .
    BIND(?assessment AS ?subject)
    BIND(mnp:producesDecision AS ?predicate)
    BIND(?decision AS ?object)
  }
  UNION
  {
    ?reason a mnp:BlockingReason .
    ?assessment mnp:producesDecision ?decision .
    ?decision mnp:hasBlockingReason ?reason .
    ?reason ?predicate ?object .
    FILTER(?predicate IN (
      mnp:supportedByEvidence,
      mnp:triggeredByRule,
      mnp:triggeredByRuleVersion,
      mnp:citesClause,
      mnp:recommendsAction
    ))
    BIND(?reason AS ?subject)
  }
  UNION
  {
    ?assessment mnp:producesDecision ?decision .
    ?decision mnp:hasBlockingReason ?reason .
    BIND(?decision AS ?subject)
    BIND(mnp:hasBlockingReason AS ?predicate)
    BIND(?reason AS ?object)
  }
  UNION
  {
    ?assessment mnp:evaluatedByRule ?rule .
    ?rule mnp:operationalizesClause ?clause .
    BIND(?rule AS ?subject)
    BIND(mnp:operationalizesClause AS ?predicate)
    BIND(?clause AS ?object)
  }
  UNION
  {
    ?assessment mnp:evaluatedByRule ?rule .
    ?rule mnp:operationalizesClause ?clause .
    ?clause mnp:partOfDocument ?doc .
    BIND(?clause AS ?subject)
    BIND(mnp:partOfDocument AS ?predicate)
    BIND(?doc AS ?object)
  }
  UNION
  {
    ?assessment mnp:usesRuleVersion ?oldRv .
    ?newRv mnp:supersedesRuleVersion ?oldRv .
    BIND(?newRv AS ?subject)
    BIND(mnp:supersedesRuleVersion AS ?predicate)
    BIND(?oldRv AS ?object)
  }
  UNION
  {
    ?newRv mnp:affectsAssessment ?assessment .
    BIND(?newRv AS ?subject)
    BIND(mnp:affectsAssessment AS ?predicate)
    BIND(?assessment AS ?object)
  }

  FILTER(isIRI(?subject) && isIRI(?predicate) && isIRI(?object))
}
ORDER BY ?subject ?predicate ?object
