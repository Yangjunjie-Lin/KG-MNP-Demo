PREFIX mnp: <http://example.org/kg-mnp#>

# Real RDF dependency subgraph for an eligibility assessment.
# Bind ?requestedCaseId externally as plain string, e.g. "CASE-03"

SELECT DISTINCT
  ?subject
  ?predicate
  ?object
  ?subjectType
  ?objectType
WHERE {
  ?case mnp:caseIdentifier ?caseId ;
        mnp:hasEligibilityAssessment ?assessment .
  FILTER(STR(?caseId) = "__CASE_ID__")

  {
    BIND(?case AS ?subject)
    BIND(mnp:hasEligibilityAssessment AS ?predicate)
    BIND(?assessment AS ?object)
  }
  UNION
  {
    ?assessment ?predicate ?object .
    FILTER(?predicate IN (
      mnp:aboutCase,
      mnp:usesEvidence,
      mnp:evaluatedByRule,
      mnp:usesRuleVersion,
      mnp:producesDecision,
      mnp:producesBlockingReason,
      mnp:dependsOn
    ))
    BIND(?assessment AS ?subject)
  }
  UNION
  {
    ?reason a mnp:BlockingReason ;
            ?predicate ?object .
    ?assessment mnp:producesBlockingReason ?reason .
    FILTER(?predicate IN (
      mnp:supportedByEvidence,
      mnp:triggeredByRule,
      mnp:triggeredByRuleVersion,
      mnp:citesClause,
      mnp:recommendsAction
    ))
    BIND(?reason AS ?subject)
  }
  UNION
  {
    ?assessment mnp:evaluatedByRule ?rule .
    ?rule mnp:operationalizesClause ?clause .
    BIND(?rule AS ?subject)
    BIND(mnp:operationalizesClause AS ?predicate)
    BIND(?clause AS ?object)
  }
  UNION
  {
    ?assessment mnp:evaluatedByRule ?rule .
    ?rule mnp:operationalizesClause ?clause .
    ?clause mnp:partOfDocument ?doc .
    BIND(?clause AS ?subject)
    BIND(mnp:partOfDocument AS ?predicate)
    BIND(?doc AS ?object)
  }
  UNION
  {
    ?assessment mnp:dependsOn ?dependency .
    ?dependency ?predicate ?object .
    FILTER(?predicate IN (
      mnp:dependsOnEvidence,
      mnp:dependsOnRuleVersion
    ))
    BIND(?dependency AS ?subject)
  }

  OPTIONAL { ?subject a ?subjectType }
  OPTIONAL { ?object a ?objectType }
}
ORDER BY ?subject ?predicate ?object
