PREFIX mnp: <http://example.org/kg-mnp#>

# Locate assessments affected by superseded rule versions.

SELECT ?assessment ?assessmentId ?oldVersion ?newVersion ?caseId ?requiresReassessment
WHERE {
  ?newRv mnp:supersedesRuleVersion ?oldRv .
  ?oldRv mnp:ruleVersion ?oldVersion .
  ?newRv mnp:ruleVersion ?newVersion .
  {
    ?newRv mnp:affectsAssessment ?assessment .
  } UNION {
    ?assessment mnp:usesRuleVersion ?oldRv .
  }
  OPTIONAL { ?assessment mnp:assessmentIdentifier ?assessmentId }
  OPTIONAL { ?assessment mnp:aboutCase ?case .
             ?case mnp:caseIdentifier ?caseId }
  OPTIONAL { ?assessment mnp:requiresReassessment ?requiresReassessment }
  OPTIONAL { ?assessment mnp:markedForReassessment ?marker }
}
ORDER BY ?assessmentId
