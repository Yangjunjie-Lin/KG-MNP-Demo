@prefix mnp: <https://yangjunjie-lin.github.io/KG-MNP-Demo/ontology/terms#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

<https://yangjunjie-lin.github.io/KG-MNP-Demo/ontology/mnp-core> a owl:Ontology ;
    owl:versionIRI <https://yangjunjie-lin.github.io/KG-MNP-Demo/ontology/1.0.0/mnp-core> ;
    owl:versionInfo "1.0.0" ;
    dcterms:title "KG-MNP Core Annotations"@en ;
    dcterms:title "KG-MNP 核心注解"@zh-CN ;
    dcterms:description "Cross-module annotation properties and governance metadata for KG-MNP."@en ;
    dcterms:description "KG-MNP 跨模块注解属性与治理元数据。"@zh-CN ;
    dcterms:license <https://www.apache.org/licenses/LICENSE-2.0> .
mnp:alignmentStatus a owl:AnnotationProperty ;
    rdfs:label "Alignment Status"@en ;
    rdfs:label "对齐状态"@zh-CN ;
    skos:definition "Human-reviewed alignment status: VERIFIED, PARTIAL, or LOCAL_ONLY."@en ;
    skos:definition "人工审定的外部对齐状态：VERIFIED、PARTIAL 或 LOCAL_ONLY。"@zh-CN ;
    mnp:moduleCode "CORE" ;
    mnp:sourceStatus "PROJECT_GOVERNANCE" ;
    mnp:definingModule "mnp-core" .

mnp:definingModule a owl:AnnotationProperty ;
    rdfs:label "Defining Module"@en ;
    rdfs:label "定义模块"@zh-CN ;
    skos:definition "Annotation naming the single defining ontology module for a term."@en ;
    skos:definition "标注术语唯一正式定义模块的注解属性。"@zh-CN ;
    mnp:moduleCode "CORE" ;
    mnp:sourceStatus "PROJECT_GOVERNANCE" ;
    mnp:definingModule "mnp-core" .

mnp:replacementTerm a owl:AnnotationProperty ;
    rdfs:label "Replacement Term"@en ;
    rdfs:label "替代术语"@zh-CN ;
    skos:definition "Points from a deprecated term to its recommended replacement."@en ;
    skos:definition "从已弃用术语指向推荐替代术语。"@zh-CN ;
    mnp:moduleCode "CORE" ;
    mnp:sourceStatus "PROJECT_GOVERNANCE" ;
    mnp:definingModule "mnp-core" .

mnp:sourceStatus a owl:AnnotationProperty ;
    rdfs:label "Source Status"@en ;
    rdfs:label "来源状态"@zh-CN ;
    skos:definition "Provenance status of a local term: LOCAL_EXTENSION, INDUSTRY_ALIGNED, STANDARD_REUSED, or PROJECT_GOVERNANCE."@en ;
    skos:definition "本地术语来源状态：LOCAL_EXTENSION、INDUSTRY_ALIGNED、STANDARD_REUSED 或 PROJECT_GOVERNANCE。"@zh-CN ;
    mnp:moduleCode "CORE" ;
    mnp:sourceStatus "PROJECT_GOVERNANCE" ;
    mnp:definingModule "mnp-core" .

mnp:moduleCode a owl:DatatypeProperty ;
    rdfs:label "Module Code"@en ;
    rdfs:label "模块代码"@zh-CN ;
    skos:definition "Catalog module code identifying the defining ontology module for a term."@en ;
    skos:definition "标识术语所属正式本体模块的目录代码。"@zh-CN ;
    mnp:moduleCode "CORE" ;
    mnp:sourceStatus "PROJECT_GOVERNANCE" ;
    mnp:definingModule "mnp-core" ;
    rdfs:range xsd:string .
