@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .

<https://yangjunjie-lin.github.io/KG-MNP-Demo/ontology/kg-mnp> a owl:Ontology ;
    owl:versionIRI <https://yangjunjie-lin.github.io/KG-MNP-Demo/ontology/1.0.0/kg-mnp> ;
    owl:versionInfo "1.0.0" ;
    dcterms:title "KG-MNP Root Ontology"@en ;
    dcterms:title "KG-MNP 根本体"@zh-CN ;
    dcterms:description "Aggregate entry point importing all runtime KG-MNP ontology modules for Protégé offline use."@en ;
    dcterms:description "导入全部运行时本体模块的聚合入口，供 Protégé 离线打开。"@zh-CN ;
    dcterms:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    owl:imports <https://yangjunjie-lin.github.io/KG-MNP-Demo/ontology/mnp-core> ;
    owl:imports <https://yangjunjie-lin.github.io/KG-MNP-Demo/ontology/mnp-identity> ;
    owl:imports <https://yangjunjie-lin.github.io/KG-MNP-Demo/ontology/mnp-account-billing> ;
    owl:imports <https://yangjunjie-lin.github.io/KG-MNP-Demo/ontology/mnp-service-contract> ;
    owl:imports <https://yangjunjie-lin.github.io/KG-MNP-Demo/ontology/mnp-process> ;
    owl:imports <https://yangjunjie-lin.github.io/KG-MNP-Demo/ontology/mnp-compliance> ;
    owl:imports <https://yangjunjie-lin.github.io/KG-MNP-Demo/ontology/mnp-evidence-time> ;
    owl:imports <https://yangjunjie-lin.github.io/KG-MNP-Demo/ontology/mnp-modeling-provenance> ;
    owl:imports <https://yangjunjie-lin.github.io/KG-MNP-Demo/ontology/mnp-code-list> .
