@prefix mnp: <https://yangjunjie-lin.github.io/KG-MNP-Demo/ontology/terms#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

#################################################################
# Alignment annotations ONLY — NOT a runtime dependency.
# Use skos:closeMatch / rdfs:seeAlso / mnp:alignmentStatus only.
# NO owl:equivalentClass / owl:equivalentProperty.
#################################################################

<https://yangjunjie-lin.github.io/KG-MNP-Demo/ontology/mnp-alignments> a owl:Ontology ;
    owl:versionIRI <https://yangjunjie-lin.github.io/KG-MNP-Demo/ontology/1.0.0/mnp-alignments> ;
    owl:versionInfo "1.0.0" ;
    dcterms:title "KG-MNP Alignments Module"@en ;
    dcterms:title "KG-MNP 对齐模块"@zh-CN ;
    dcterms:description "Optional external alignment annotations; not a default runtime import. Uses skos:closeMatch, rdfs:seeAlso, and mnp:alignmentStatus only — never owl:equivalentClass or owl:equivalentProperty."@en ;
    dcterms:description "可选外部对齐注解；不作为默认运行时导入。仅使用 skos:closeMatch、rdfs:seeAlso 与 mnp:alignmentStatus，绝不使用 owl:equivalentClass 或 owl:equivalentProperty。"@zh-CN ;
    dcterms:license <https://www.apache.org/licenses/LICENSE-2.0> ;
    owl:imports <https://yangjunjie-lin.github.io/KG-MNP-Demo/ontology/mnp-core> .

# --- Subscriber ---
mnp:Subscriber
    mnp:alignmentStatus "PARTIAL" ;
    dcterms:source "TM Forum TMF629 Customer Management — Customer object provides industry field basis; mapped via mappings/tmf_to_mnp.yaml" ;
    rdfs:seeAlso <https://github.com/tmforum-apis/TMF629_CustomerManagement> ;
    rdfs:seeAlso <https://github.com/Point-Topic/cto-ontology> ;
    rdfs:comment "Compared with foaf:Person in CTO (person/party layer). Subscriber is a telecom-role specialization; not claimed equivalent."@en .

# --- PhoneNumber ---
mnp:PhoneNumber
    mnp:alignmentStatus "LOCAL_ONLY" ;
    dcterms:source "Local MNP domain concept; no direct CTO PhoneNumber class found in cto_core.ttl / cto_extended.ttl (reviewed 2026-07-30)." ;
    rdfs:seeAlso <https://github.com/Point-Topic/cto-ontology/blob/main/resource/cto_core.ttl> .

# --- TelecomAccount ---
mnp:TelecomAccount
    mnp:alignmentStatus "PARTIAL" ;
    dcterms:source "TM Forum TMF629 relatedParty / relatedAccount and CustomerAccount patterns (schema mapping layer)." ;
    rdfs:seeAlso <https://github.com/tmforum-apis/TMF629_CustomerManagement> .

# --- TelecomService ---
mnp:TelecomService
    mnp:alignmentStatus "PARTIAL" ;
    dcterms:source "TM Forum TMF620 ProductOffering / ProductSpecification; conceptually compared with CTO Service / CellularService." ;
    rdfs:seeAlso <https://github.com/tmforum-apis/TMF620_ProductCatalog> ;
    rdfs:seeAlso <https://github.com/Point-Topic/cto-ontology/blob/main/resource/cto_extended.ttl> ;
    skos:closeMatch <https://github.com/Point-Topic/cto-ontology/#Service> ;
    rdfs:comment "CTO Service (and CellularService subclass) describe telecom services. closeMatch only — CTO Service also covers broadband market catalogue semantics; MNP term is operational/catalog for portability."@en .

# --- ServiceSubscription ---
mnp:ServiceSubscription
    mnp:alignmentStatus "PARTIAL" ;
    dcterms:source "TM Forum TMF637 Product Inventory Product instance and status fields." ;
    rdfs:seeAlso <https://github.com/tmforum-apis/TMF637_ProductInventory> .

# --- ServiceContract ---
mnp:ServiceContract
    mnp:alignmentStatus "LOCAL_ONLY" ;
    dcterms:source "Local MNP eligibility concept. CTO has hasContractLength on BroadbandService (data property), not a first-class ServiceContract class." ;
    rdfs:seeAlso <https://github.com/Point-Topic/cto-ontology/blob/main/resource/cto_extended.ttl> .

# --- MNPCase and eligibility stack ---
mnp:MNPCase
    mnp:alignmentStatus "LOCAL_ONLY" ;
    dcterms:source "Local MNP case concept; not present in CTO or TM Forum as OWL class." .

mnp:EligibilityAssessment
    mnp:alignmentStatus "LOCAL_ONLY" ;
    dcterms:source "Local evidence-rule-decision assessment concept." .

mnp:EvidenceRecord
    mnp:alignmentStatus "PARTIAL" ;
    dcterms:source "Conceptually compared with CTO MeasurementRecord (observation with magnitude/aspect). Different purpose: MNP evidence includes provenance, validity window, and status." ;
    rdfs:seeAlso <https://github.com/Point-Topic/cto-ontology/blob/main/resource/cto_core.ttl> ;
    rdfs:comment "Not skos:closeMatch — MeasurementRecord is quantitative measurement; EvidenceRecord is eligibility provenance."@en .

mnp:InformationSystem
    mnp:alignmentStatus "PARTIAL" ;
    dcterms:source "Compared with CTO WholesaleAccessPlatform / dcat:DataService as information channels; not equivalent." ;
    rdfs:seeAlso <https://github.com/Point-Topic/cto-ontology/blob/main/resource/cto_extended.ttl> .
