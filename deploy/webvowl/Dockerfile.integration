# Stage 08 integration image. The build context is the repository root after
# scripts/fetch_webvowl_upstream.py has verified both exact upstream commits.
ARG MAVEN_IMAGE=maven:3.9.16-eclipse-temurin-8-noble
ARG MAVEN_DIGEST=sha256:0537e78bbba084ec350fcaa0dedef6efa34440e4e464bbb284f0f1e47043f629
ARG NODE_IMAGE=node:12-alpine
ARG NODE_DIGEST=sha256:4517380049fc3c9aacceae7764fcf3500354b0ac8a47e4afb35b5bbeb75b9498
ARG WEBVOWL_NPM_SHRINKWRAP_SHA256=74c5094525121337d6b71d0862ec9543a0356e536b00fe67b45f03d031f0fdda
ARG TOMCAT_JRE_IMAGE=tomcat:9.0.118-jre8-temurin-noble
ARG TOMCAT_JRE_DIGEST=sha256:6ac38ff9831b03e18e83174eca45d746f2accde3a5c8f8bc48ba2c9fd63b8b17
ARG TOMCAT_JDK_IMAGE=tomcat:9.0.118-jdk8-temurin-noble
ARG TOMCAT_JDK_DIGEST=sha256:41836df54c3781e0e835e61a4761b566d0de9187eb6c56340191b343e1fe3101

FROM ${MAVEN_IMAGE}@${MAVEN_DIGEST} AS owl2vowl-builder
WORKDIR /build/owl2vowl
COPY upstream-source/owl2vowl/pom.xml .
RUN mvn -B dependency:go-offline -P war-release
COPY upstream-source/owl2vowl/src src
RUN mvn -B package -P war-release -DskipTests

FROM owl2vowl-builder AS owl2vowl-cli-builder
RUN mvn -B package -P standalone-release -DskipTests

FROM ${NODE_IMAGE}@${NODE_DIGEST} AS webvowl-builder
ARG WEBVOWL_NPM_SHRINKWRAP_SHA256
WORKDIR /build/webvowl
COPY upstream-source/webvowl/package.json upstream-source/webvowl/Gruntfile.js upstream-source/webvowl/webpack.config.js ./
COPY deploy/webvowl/webvowl-npm-shrinkwrap.json ./npm-shrinkwrap.json
COPY upstream-source/webvowl/.jshintrc upstream-source/webvowl/.jshintignore ./
COPY upstream-source/webvowl/src src
COPY upstream-source/webvowl/util util
COPY upstream-source/webvowl/license.txt .
# The frozen upstream stylesheet imports Google Fonts over plain HTTP.  The
# Stage 08 browser contract forbids every non-loopback request, so remove that
# presentation-only import before producing the isolated runtime assets.
RUN echo "${WEBVOWL_NPM_SHRINKWRAP_SHA256}  npm-shrinkwrap.json" | sha256sum -c - \
    && sed -i '\|fonts.googleapis.com|d' src/app/css/toolstyle.css \
    && ! grep -R -n 'fonts.googleapis.com' src \
    && npm ci --ignore-scripts --no-audit --no-fund \
    && npm run release

FROM ${TOMCAT_JDK_IMAGE}@${TOMCAT_JDK_DIGEST} AS owl2vowl-expand
RUN rm -rf "${CATALINA_HOME}/webapps/"* && mkdir -p "${CATALINA_HOME}/webapps/ROOT"
COPY --from=owl2vowl-builder /build/owl2vowl/target/owl2vowl.war /tmp/owl2vowl.war
RUN cd "${CATALINA_HOME}/webapps/ROOT" && jar xf /tmp/owl2vowl.war && rm /tmp/owl2vowl.war

FROM ${TOMCAT_JRE_IMAGE}@${TOMCAT_JRE_DIGEST} AS webvowl-runtime
ENV CATALINA_HOME=/usr/local/tomcat
RUN rm -rf "$CATALINA_HOME/webapps"/* && mkdir -p "$CATALINA_HOME/webapps/ROOT" /opt/ontology-input \
    && chown -R 1000:1000 "$CATALINA_HOME/webapps" /opt/ontology-input
COPY --from=owl2vowl-expand /usr/local/tomcat/webapps/ROOT/ /usr/local/tomcat/webapps/ROOT/
COPY --from=webvowl-builder /build/webvowl/deploy/ /usr/local/tomcat/webapps/ROOT/
RUN chown -R 1000:1000 /usr/local/tomcat/webapps
USER 1000:1000
EXPOSE 8080
HEALTHCHECK --interval=10s --timeout=5s --retries=12 CMD curl --fail --silent http://127.0.0.1:8080/serverTimeStamp >/dev/null || exit 1
CMD ["catalina.sh", "run"]

FROM ${NODE_IMAGE}@${NODE_DIGEST} AS loopback-proxy
WORKDIR /opt/kg-mnp-loopback-proxy
COPY deploy/webvowl/loopback-proxy.js ./server.js
USER node
EXPOSE 8080
CMD ["node", "server.js"]
