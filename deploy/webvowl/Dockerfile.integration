# Explicit optional OWL2VOWL CLI conversion image, not another web application.
# Sources are verified by scripts/fetch_webvowl_upstream.py before this build.
ARG MAVEN_IMAGE=maven:3.9.16-eclipse-temurin-8-noble
ARG MAVEN_DIGEST=sha256:0537e78bbba084ec350fcaa0dedef6efa34440e4e464bbb284f0f1e47043f629

FROM ${MAVEN_IMAGE}@${MAVEN_DIGEST} AS owl2vowl-cli-builder
WORKDIR /build/owl2vowl
COPY upstream-source/owl2vowl/pom.xml .
COPY upstream-source/owl2vowl/LICENSE.txt .
RUN mvn -B dependency:go-offline -P standalone-release
COPY upstream-source/owl2vowl/src src
RUN mvn -B package -P standalone-release -DskipTests
