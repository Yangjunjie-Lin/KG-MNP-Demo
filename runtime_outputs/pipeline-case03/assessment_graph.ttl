@prefix dcterms: <http://purl.org/dc/terms/> .
@prefix mnp: <http://example.org/kg-mnp#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

mnp:Action-RESTORE_NUMBER_STATUS a mnp:RemediationAction,
        owl:Thing ;
    mnp:actionCode "RESTORE_NUMBER_STATUS" ;
    mnp:actionDescription "请先恢复号码至正常可用状态。" ;
    owl:sameAs mnp:Action-RESTORE_NUMBER_STATUS .

mnp:Action-SETTLE_OUTSTANDING_FEES a mnp:RemediationAction,
        owl:Thing ;
    mnp:actionCode "SETTLE_OUTSTANDING_FEES" ;
    mnp:actionDescription "请结清欠费，或办理有效缴费约定后再申请。" ;
    owl:sameAs mnp:Action-SETTLE_OUTSTANDING_FEES .

mnp:Action-SUPPLY_MISSING_EVIDENCE a mnp:RemediationAction,
        owl:Thing ;
    mnp:actionCode "SUPPLY_MISSING_EVIDENCE" ;
    mnp:actionDescription "请补充缺失或过期的关键证据后由人工复核。" ;
    owl:sameAs mnp:Action-SUPPLY_MISSING_EVIDENCE .

mnp:Action-VERIFY_IDENTITY a mnp:RemediationAction,
        owl:Thing ;
    mnp:actionCode "VERIFY_IDENTITY" ;
    mnp:actionDescription "请核对并更新实名登记信息后重新申请。" ;
    owl:sameAs mnp:Action-VERIFY_IDENTITY .

mnp:Action-WAIT_PORTING_INTERVAL a mnp:RemediationAction,
        owl:Thing ;
    mnp:actionCode "WAIT_PORTING_INTERVAL" ;
    mnp:actionDescription "请等待满足最短携转间隔后再申请。" ;
    owl:sameAs mnp:Action-WAIT_PORTING_INTERVAL .

mnp:Assessment-CASE-03 a mnp:EligibilityAssessment ;
    mnp:aboutCase mnp:Case-CASE-03 ;
    mnp:assessmentIdentifier "ASSESS-CASE-03" ;
    mnp:dependsOn mnp:Dep-CASE-03 ;
    mnp:evaluatedByRule mnp:Rule-MNP-ELIG-001,
        mnp:Rule-MNP-ELIG-002,
        mnp:Rule-MNP-ELIG-003,
        mnp:Rule-MNP-ELIG-004,
        mnp:Rule-MNP-ELIG-005-v1-1 ;
    mnp:producesBlockingReason mnp:Reason-CASE-03-ACTIVE_CONTRACT_RESTRICTION ;
    mnp:producesDecision mnp:Decision-CASE-03 ;
    mnp:usesEvidence mnp:Evidence-CASE-03-BILLING,
        mnp:Evidence-CASE-03-CONTRACT,
        mnp:Evidence-CASE-03-IDENTITY,
        mnp:Evidence-CASE-03-NUMBER,
        mnp:Evidence-CASE-03-PORTING ;
    mnp:usesRuleVersion mnp:RuleVersion-MNP-ELIG-001-1-0,
        mnp:RuleVersion-MNP-ELIG-002-1-0,
        mnp:RuleVersion-MNP-ELIG-003-1-0,
        mnp:RuleVersion-MNP-ELIG-004-1-0,
        mnp:RuleVersion-MNP-ELIG-005-1-1 .

mnp:Decision-CASE-03 a mnp:BlockingDecision ;
    mnp:decisionCode "BLOCKED" .

mnp:Dep-CASE-03 a mnp:AssessmentDependency ;
    mnp:dependsOnEvidence mnp:Evidence-CASE-03-BILLING,
        mnp:Evidence-CASE-03-CONTRACT,
        mnp:Evidence-CASE-03-IDENTITY,
        mnp:Evidence-CASE-03-NUMBER,
        mnp:Evidence-CASE-03-PORTING ;
    mnp:dependsOnRuleVersion mnp:RuleVersion-MNP-ELIG-001-1-0,
        mnp:RuleVersion-MNP-ELIG-002-1-0,
        mnp:RuleVersion-MNP-ELIG-003-1-0,
        mnp:RuleVersion-MNP-ELIG-004-1-0,
        mnp:RuleVersion-MNP-ELIG-005-1-1 .

mnp:Map-TMF620-Offering a mnp:MappingRecord,
        owl:Thing ;
    mnp:mappingReviewStatus "reviewed" ;
    mnp:sourceApi "TMF620_ProductCatalog" ;
    mnp:sourceFieldPath "components.schemas.ProductOffering" ;
    mnp:targetTerm "mnp:TelecomService" ;
    owl:sameAs mnp:Map-TMF620-Offering .

mnp:Map-TMF629-Customer a mnp:MappingRecord,
        owl:Thing ;
    mnp:mappingReviewStatus "reviewed" ;
    mnp:sourceApi "TMF629_CustomerManagement" ;
    mnp:sourceFieldPath "components.schemas.Customer" ;
    mnp:targetTerm "mnp:Subscriber" ;
    owl:sameAs mnp:Map-TMF629-Customer .

mnp:Map-TMF637-Product a mnp:MappingRecord,
        owl:Thing ;
    mnp:mappingReviewStatus "reviewed" ;
    mnp:sourceApi "TMF637_ProductInventory" ;
    mnp:sourceFieldPath "components.schemas.Product" ;
    mnp:targetTerm "mnp:ServiceSubscription" ;
    owl:sameAs mnp:Map-TMF637-Product .

mnp:Reason-CASE-03-ACTIVE_CONTRACT_RESTRICTION a mnp:BlockingReason ;
    mnp:citesClause mnp:Clause-04 ;
    mnp:reasonCode "ACTIVE_CONTRACT_RESTRICTION" ;
    mnp:reasonDescription "failed check for CONTRACT_STATUS" ;
    mnp:recommendsAction mnp:Action-WAIT_OR_TERMINATE_CONTRACT ;
    mnp:supportedByEvidence mnp:Evidence-CASE-03-CONTRACT ;
    mnp:triggeredByRule mnp:Rule-MNP-ELIG-004 ;
    mnp:triggeredByRuleVersion mnp:RuleVersion-MNP-ELIG-004-1-0 .

mnp:Rule-MNP-ELIG-005 a _:n4900baee74a0413ea0227d839d593993b8,
        mnp:EligibilityRule,
        owl:Thing ;
    mnp:effectiveFrom "2024-01-01T00:00:00+00:00"^^xsd:dateTime ;
    mnp:hasRuleVersion mnp:RuleVersion-MNP-ELIG-005-1-0 ;
    mnp:operationalizesClause mnp:Clause-05 ;
    mnp:ruleIdentifier "MNP-ELIG-005" ;
    mnp:ruleVersion "1.0" ;
    owl:sameAs mnp:Rule-MNP-ELIG-005 .

mnp:alignmentStatus a owl:AnnotationProperty ;
    rdfs:label "Alignment Status"@en ;
    rdfs:comment "VERIFIED, PARTIAL, or LOCAL_ONLY."@en ;
    owl:sameAs mnp:alignmentStatus .

<http://example.org/kg-mnp/compliance> a owl:Ontology ;
    dcterms:title "KG-MNP Compliance Ontology"@en ;
    rdfs:comment "Compliance-oriented extensions for regulatory operationalization and reassessment."@en ;
    owl:imports <http://example.org/kg-mnp/core> ;
    owl:sameAs <http://example.org/kg-mnp/compliance> ;
    owl:versionInfo "0.1.0" .

