mnp:Action-WAIT_OR_TERMINATE_CONTRACT a mnp:RemediationAction,
        owl:Thing ;
    mnp:actionCode "WAIT_OR_TERMINATE_CONTRACT" ;
    mnp:actionDescription "请等待合约到期，或按约定办理解约后再申请。" ;
    owl:sameAs mnp:Action-WAIT_OR_TERMINATE_CONTRACT .

mnp:Clause-01 a mnp:RegulatoryClause,
        owl:Thing ;
    rdfs:label "Real-name consistency clause" ;
    mnp:clauseIdentifier "REG-MNP-CLAUSE-01" ;
    mnp:clauseText "申请人实名信息须与号码登记实名信息一致方可办理携号转网。" ;
    mnp:partOfDocument mnp:Doc-MNP-Regulation-2024 ;
    owl:sameAs mnp:Clause-01 .

mnp:Clause-02 a mnp:RegulatoryClause,
        owl:Thing ;
    rdfs:label "Number status clause" ;
    mnp:clauseIdentifier "REG-MNP-CLAUSE-02" ;
    mnp:clauseText "申请携转的号码须处于正常可用状态。" ;
    mnp:partOfDocument mnp:Doc-MNP-Regulation-2024 ;
    owl:sameAs mnp:Clause-02 .

mnp:Clause-03 a mnp:RegulatoryClause,
        owl:Thing ;
    rdfs:label "Billing clearance clause" ;
    mnp:clauseIdentifier "REG-MNP-CLAUSE-03" ;
    mnp:clauseText "申请携转前须结清相关费用，或存在有效缴费约定。" ;
    mnp:partOfDocument mnp:Doc-MNP-Regulation-2024 ;
    owl:sameAs mnp:Clause-03 .

