PREFIX f: <https://example.invalid/forestry#>
SELECT ?tree ?treeCode ?inspection ?inspectionCode ?site WHERE {
 ?tree a f:TreeRecord ; f:treeCode ?treeCode ; f:locatedAt ?site .
 ?inspection a f:InspectionRecord ; f:inspectionCode ?inspectionCode ; f:inspectedTree ?tree .
} ORDER BY ?treeCode ?inspectionCode
