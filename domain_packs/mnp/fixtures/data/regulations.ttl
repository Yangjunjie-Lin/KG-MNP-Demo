    mnp:effectiveFrom "2026-06-01T00:00:00Z"^^xsd:dateTime ;
    mnp:supersedesRuleVersion data:RuleVersion-MNP-ELIG-005-1-0 .

# Remediation action catalogue
data:Action-VERIFY_IDENTITY a mnp:RemediationAction ;
    mnp:actionCode "VERIFY_IDENTITY" ;
    mnp:actionDescription "请核对并更新实名登记信息后重新申请。" .

data:Action-RESTORE_NUMBER_STATUS a mnp:RemediationAction ;
    mnp:actionCode "RESTORE_NUMBER_STATUS" ;
    mnp:actionDescription "请先恢复号码至正常可用状态。" .

data:Action-SETTLE_OUTSTANDING_FEES a mnp:RemediationAction ;
    mnp:actionCode "SETTLE_OUTSTANDING_FEES" ;
    mnp:actionDescription "请结清欠费，或办理有效缴费约定后再申请。" .

data:Action-WAIT_OR_TERMINATE_CONTRACT a mnp:RemediationAction ;
    mnp:actionCode "WAIT_OR_TERMINATE_CONTRACT" ;
    mnp:actionDescription "请等待合约到期，或按约定办理解约后再申请。" .

data:Action-WAIT_PORTING_INTERVAL a mnp:RemediationAction ;
    mnp:actionCode "WAIT_PORTING_INTERVAL" ;
    mnp:actionDescription "请等待满足最短携转间隔后再申请。" .

data:Action-SUPPLY_MISSING_EVIDENCE a mnp:RemediationAction ;
    mnp:actionCode "SUPPLY_MISSING_EVIDENCE" ;
    mnp:actionDescription "请补充缺失或过期的关键证据后由人工复核。" .
