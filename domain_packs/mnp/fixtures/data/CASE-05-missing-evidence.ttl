@prefix mnp: <https://yangjunjie-lin.github.io/KG-MNP-Demo/ontology/terms#> .
@prefix data: <https://yangjunjie-lin.github.io/KG-MNP-Demo/data/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# CASE-05: critical billing evidence expired → MANUAL_REVIEW

data:Sub-05 a mnp:Subscriber ;
    mnp:holdsSubscription data:Subscr-05  .
data:Phone-05 a mnp:PhoneNumber ;
    mnp:assignedToSubscription data:Subscr-05 ;
    mnp:maskedPhoneNumber "138****0005" .

data:Acct-05 a mnp:TelecomAccount .

data:Subscr-05 a mnp:ServiceSubscription ;
    mnp:billedThrough data:Acct-05 ;
    mnp:subscribesToService data:Svc-Mobile-Basic ;
    mnp:subscriptionStatusCode "ACTIVE" ;
    mnp:governedByContract data:Contract-05 .

data:Contract-05 a mnp:ServiceContract ;
    mnp:contractStatusCode "EXPIRED" ;
    mnp:contractEndTime "2025-01-01T00:00:00Z"^^xsd:dateTime .

data:CASE-05 a mnp:MNPCase ;
    mnp:caseIdentifier "CASE-05" ;
    mnp:concernsNumber data:Phone-05 ;
    mnp:requestedBy data:Sub-05 ;
    mnp:hasCaseEvidence
        data:Ev-05-ID ,
        data:Ev-05-NUM ,
        data:Ev-05-BILL ,
        data:Ev-05-CTR ,
        data:Ev-05-PORT .

data:Ev-05-ID a mnp:SystemObservation ;
    mnp:evidenceType "IDENTITY_MATCH" ;
    mnp:identityMatchFlag true ;
    mnp:evidenceStatus "VALID" ;
    mnp:evidenceGeneratedAt "2026-06-20T10:00:00Z"^^xsd:dateTime ;
    mnp:evidenceValidUntil "2026-12-31T23:59:59Z"^^xsd:dateTime ;
    mnp:hasSourceSystem data:SYS-CRM .

data:Ev-05-NUM a mnp:SystemObservation ;
    mnp:evidenceType "NUMBER_STATUS" ;
    mnp:numberStatusCode "ACTIVE" ;
    mnp:evidenceStatus "VALID" ;
    mnp:evidenceGeneratedAt "2026-06-20T10:05:00Z"^^xsd:dateTime ;
    mnp:evidenceValidUntil "2026-12-31T23:59:59Z"^^xsd:dateTime ;
    mnp:hasSourceSystem data:SYS-HLR .

# Billing evidence EXPIRED — must not be treated as cleared
data:Ev-05-BILL a mnp:SystemObservation ;
    mnp:evidenceType "BILLING_BALANCE" ;
    mnp:observedAmount "0.00"^^xsd:decimal ;
    mnp:currencyCode "CNY" ;
    mnp:hasPaymentArrangement false ;
    mnp:evidenceStatus "EXPIRED" ;
    mnp:evidenceGeneratedAt "2025-01-01T10:10:00Z"^^xsd:dateTime ;
    mnp:evidenceValidUntil "2025-02-01T00:00:00Z"^^xsd:dateTime ;
    mnp:hasSourceSystem data:SYS-BILLING .

data:Ev-05-CTR a mnp:SystemObservation ;
    mnp:evidenceType "CONTRACT_STATUS" ;
    mnp:contractStatusCode "EXPIRED" ;
    mnp:contractEndTime "2025-01-01T00:00:00Z"^^xsd:dateTime ;
    mnp:evidenceStatus "VALID" ;
    mnp:evidenceGeneratedAt "2026-06-20T10:15:00Z"^^xsd:dateTime ;
    mnp:evidenceValidUntil "2026-12-31T23:59:59Z"^^xsd:dateTime ;
    mnp:hasSourceSystem data:SYS-CONTRACT .

data:Ev-05-PORT a mnp:SystemObservation ;
    mnp:evidenceType "PORTING_HISTORY" ;
    mnp:daysSinceLastPort 500 ;
    mnp:evidenceStatus "VALID" ;
    mnp:evidenceGeneratedAt "2026-06-20T10:20:00Z"^^xsd:dateTime ;
    mnp:evidenceValidUntil "2026-12-31T23:59:59Z"^^xsd:dateTime ;
    mnp:hasSourceSystem data:SYS-MNP .
