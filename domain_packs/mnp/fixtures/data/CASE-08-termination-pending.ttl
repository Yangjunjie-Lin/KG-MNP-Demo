@prefix mnp: <https://yangjunjie-lin.github.io/KG-MNP-Demo/ontology/terms#> .
@prefix data: <https://yangjunjie-lin.github.io/KG-MNP-Demo/data/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# CASE-08: all conditions satisfied → ELIGIBLE

data:Sub-08 a mnp:Subscriber ;
    rdfs:label "Subscriber 08" ;
    mnp:holdsSubscription data:Subscr-08  .
data:Phone-08 a mnp:PhoneNumber ;
    mnp:assignedToSubscription data:Subscr-08 ;
    mnp:maskedPhoneNumber "138****0008" .

data:Acct-08 a mnp:TelecomAccount ;
    rdfs:label "Account 08" .

data:Svc-Mobile-Basic a mnp:TelecomService ;
    rdfs:label "Mobile Basic Plan" .

data:Subscr-08 a mnp:ServiceSubscription ;
    mnp:billedThrough data:Acct-08 ;
    mnp:subscribesToService data:Svc-Mobile-Basic ;
    mnp:subscriptionStatusCode "ACTIVE" ;
    mnp:governedByContract data:Contract-08 .

data:Contract-08 a mnp:ServiceContract ;
    mnp:contractStatusCode "ACTIVE" ;
    mnp:contractEndTime "2027-06-01T00:00:00Z"^^xsd:dateTime .

data:CASE-08 a mnp:MNPCase ;
    mnp:caseIdentifier "CASE-08" ;
    mnp:concernsNumber data:Phone-08 ;
    mnp:requestedBy data:Sub-08 ;
    mnp:hasCaseEvidence
        data:Ev-08-ID ,
        data:Ev-08-NUM ,
        data:Ev-08-BILL ,
        data:Ev-08-CTR ,
        data:Ev-08-PORT .

data:Ev-08-ID a mnp:SystemObservation ;
    mnp:evidenceType "IDENTITY_MATCH" ;
    mnp:identityMatchFlag true ;
    mnp:evidenceStatus "VALID" ;
    mnp:evidenceGeneratedAt "2026-06-20T10:00:00Z"^^xsd:dateTime ;
    mnp:evidenceValidUntil "2026-12-31T23:59:59Z"^^xsd:dateTime ;
    mnp:hasSourceSystem data:SYS-CRM .

data:Ev-08-NUM a mnp:SystemObservation ;
    mnp:evidenceType "NUMBER_STATUS" ;
    mnp:numberStatusCode "ACTIVE" ;
    mnp:evidenceStatus "VALID" ;
    mnp:evidenceGeneratedAt "2026-06-20T10:05:00Z"^^xsd:dateTime ;
    mnp:evidenceValidUntil "2026-12-31T23:59:59Z"^^xsd:dateTime ;
    mnp:hasSourceSystem data:SYS-HLR .

data:Ev-08-BILL a mnp:SystemObservation ;
    mnp:evidenceType "BILLING_BALANCE" ;
    mnp:observedAmount "0.00"^^xsd:decimal ;
    mnp:currencyCode "CNY" ;
    mnp:hasPaymentArrangement false ;
    mnp:evidenceStatus "VALID" ;
    mnp:evidenceGeneratedAt "2026-06-20T10:10:00Z"^^xsd:dateTime ;
    mnp:evidenceValidUntil "2026-12-31T23:59:59Z"^^xsd:dateTime ;
    mnp:hasSourceSystem data:SYS-BILLING .

data:Ev-08-CTR a mnp:SystemObservation ;
    mnp:evidenceType "CONTRACT_STATUS" ;
    mnp:contractStatusCode "ACTIVE" ;
    mnp:contractEndTime "2027-06-01T00:00:00Z"^^xsd:dateTime ;
    mnp:evidenceStatus "VALID" ;
    mnp:evidenceGeneratedAt "2026-06-20T10:15:00Z"^^xsd:dateTime ;
    mnp:evidenceValidUntil "2026-12-31T23:59:59Z"^^xsd:dateTime ;
    mnp:hasSourceSystem data:SYS-CONTRACT .

data:Ev-08-PORT a mnp:SystemObservation ;
    mnp:evidenceType "PORTING_HISTORY" ;
    mnp:daysSinceLastPort 400 ;
    mnp:evidenceStatus "VALID" ;
    mnp:evidenceGeneratedAt "2026-06-20T10:20:00Z"^^xsd:dateTime ;
    mnp:evidenceValidUntil "2026-12-31T23:59:59Z"^^xsd:dateTime ;
    mnp:hasSourceSystem data:SYS-MNP .

mnp:Termination-08 a mnp:TerminationAgreement ;
    mnp:terminationSignedAt "2026-06-20T00:00:00Z"^^xsd:dateTime ;
    mnp:terminationEffectiveAt "2026-08-01T00:00:00Z"^^xsd:dateTime ;
    mnp:terminationStatusCode "SIGNED_PENDING_EFFECTIVE" .

data:Contract-08 mnp:hasTerminationAgreement mnp:Termination-08 .
