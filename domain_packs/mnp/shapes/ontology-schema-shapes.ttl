shapes:OntologyVersionIRIShape a sh:NodeShape ;
    rdfs:label "Ontology version IRI"@en ;
    rdfs:label "本体版本 IRI"@zh-CN ;
    sh:severity sh:Violation ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX owl: <http://www.w3.org/2002/07/owl#>
            SELECT ?this WHERE {
                ?this a owl:Ontology .
                FILTER(STRSTARTS(STR(?this), "https://yangjunjie-lin.github.io/KG-MNP-Demo/ontology/"))
            }
        """ ;
    ] ;
    sh:property [
        sh:path owl:versionIRI ;
        sh:minCount 1 ;
        sh:nodeKind sh:IRI ;
        sh:message "Ontology resource must declare owl:versionIRI as an IRI."@en ;
        sh:message "本体资源必须声明 IRI 形式的 owl:versionIRI。"@zh-CN ;
    ] .
