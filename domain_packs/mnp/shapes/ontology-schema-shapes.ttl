@prefix mnp: <https://yangjunjie-lin.github.io/KG-MNP-Demo/ontology/terms#> .
@prefix shapes: <https://yangjunjie-lin.github.io/KG-MNP-Demo/shapes#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .

#################################################################
# Ontology schema profile — TBox annotation quality
# Targets formal mnp: terms only (SPARQL). Domain/range not required.
# Bilingual checks use SPARQL (sh:languageIn would reject sibling langs).
#################################################################

shapes:ClassLabelShape a sh:NodeShape ;
    rdfs:label "Class bilingual labels"@en ;
    rdfs:label "类双语标签"@zh-CN ;
    sh:severity sh:Violation ;
    sh:target [
        a sh:SPARQLTarget ;
        sh:select """
            PREFIX owl: <http://www.w3.org/2002/07/owl#>
            SELECT ?this WHERE {
                ?this a owl:Class .
                FILTER(STRSTARTS(STR(?this), "https://yangjunjie-lin.github.io/KG-MNP-Demo/ontology/terms#"))
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Formal class must have rdfs:label@en."@en ;
        sh:message "正式类必须具有 rdfs:label@en。"@zh-CN ;
        sh:select """
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            SELECT $this WHERE {
                FILTER NOT EXISTS {
                    $this rdfs:label ?label .
                    FILTER(lang(?label) = "en")
                }
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "Formal class must have rdfs:label@zh-CN."@en ;
        sh:message "正式类必须具有 rdfs:label@zh-CN。"@zh-CN ;
        sh:select """
            PREFIX rdfs: <http://www.w3.org/2000/01/rdf-schema#>
            SELECT $this WHERE {
                FILTER NOT EXISTS {
                    $this rdfs:label ?label .
                    FILTER(lang(?label) = "zh-CN")
                }
            }
        """ ;
    ] .

