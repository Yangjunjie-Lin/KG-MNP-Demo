PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX mnp: <https://yangjunjie-lin.github.io/KG-MNP-Demo/ontology/terms#>
SELECT ?provenanceGraph ?assertion ?subject ?predicate ?object ?candidateId ?decisionId ?evidenceRef ?sourceRef
WHERE {
  VALUES ?evidenceRef { @@PARAM_evidence_ref@@ }
  VALUES ?provenanceGraph { @@GRAPH_provenanceGraph@@ }
  GRAPH ?provenanceGraph {
    ?assertion a owl:Axiom ; owl:annotatedSource ?subject ; owl:annotatedProperty ?predicate ; owl:annotatedTarget ?object ; dcterms:relation ?candidateId ; mnp:hasReviewDecision ?decisionId ; mnp:hasModelingEvidence ?evidenceRef .
    OPTIONAL { ?assertion dcterms:source ?sourceRef . FILTER(STRSTARTS(STR(?sourceRef), "urn:kg-mnp:source-")) }
  }
}
ORDER BY ?assertion ?sourceRef
LIMIT @@LIMIT@@
OFFSET @@OFFSET@@
