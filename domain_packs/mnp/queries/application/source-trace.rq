PREFIX dcterms: <http://purl.org/dc/terms/>
PREFIX owl: <http://www.w3.org/2002/07/owl#>
PREFIX mnp: <https://yangjunjie-lin.github.io/KG-MNP-Demo/ontology/terms#>
SELECT ?provenanceGraph ?assertion ?subject ?predicate ?object ?candidateId ?decisionId ?evidenceRef ?sourceRef
WHERE {
  VALUES ?sourceRef { @@PARAM_source_ref@@ }
  VALUES ?provenanceGraph { @@GRAPH_provenanceGraph@@ }
  GRAPH ?provenanceGraph {
    ?assertion a owl:Axiom ; owl:annotatedSource ?subject ; owl:annotatedProperty ?predicate ; owl:annotatedTarget ?object ; dcterms:source ?sourceRef ; dcterms:relation ?candidateId ; mnp:hasReviewDecision ?decisionId .
    OPTIONAL { ?assertion mnp:hasModelingEvidence ?evidenceRef . }
  }
}
ORDER BY ?assertion ?evidenceRef
LIMIT @@LIMIT@@
OFFSET @@OFFSET@@
