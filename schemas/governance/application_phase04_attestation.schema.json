    "rdf_mutation_attempts": {"$ref": "#/$defs/count"}, "rdf_mutation_blocked": {"$ref": "#/$defs/count"},
    "repository_expected_hash": {"$ref": "#/$defs/hash"}, "repository_before_hash": {"$ref": "#/$defs/hash"}, "repository_after_hash": {"$ref": "#/$defs/hash"},
    "repository_unchanged": {"type": "boolean"}, "diagnostic_hash_before": {"$ref": "#/$defs/hash"}, "diagnostic_hash_after": {"$ref": "#/$defs/hash"}, "diagnostic_unchanged": {"type": "boolean"},
    "status": {"enum": ["APPLICATION_HUMAN_GOVERNANCE_VERIFIED", "FAILED"]}
