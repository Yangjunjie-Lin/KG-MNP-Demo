{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/governance/application-phase04-attestation/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "commit_sha", "stage08_baseline", "phase01_baseline", "phase02_baseline", "phase03_baseline",
    "upstream_verification_mode", "authority_type", "publication_id", "publication_semantic_hash", "repository_semantic_hash",
    "upstream_phase03_attestation_sha256", "upstream_phase03_diagnostic_package_hash", "upstream_phase03_issues_total",
    "governance_contract_hash", "production_workspace_hash", "production_workspace_revision", "production_proposals_created",
    "production_reviews_approved", "production_reviews_rejected", "production_reviews_deferred", "production_amendment_requests",
    "controlled_fixture_hash", "controlled_fixture_diagnostic_package_hash", "controlled_fixture_status",
    "controlled_scenarios_total", "controlled_scenarios_passed",
    "authority_laundering_attempts", "authority_laundering_blocked",
    "illegal_transition_attempts", "illegal_transition_blocked", "stale_binding_attempts", "stale_binding_blocked",
    "replay_attempts", "replay_blocked", "concurrency_attempts", "concurrency_blocked", "csrf_attempts", "csrf_blocked",
    "xss_attempts", "xss_blocked", "rdf_mutation_attempts", "rdf_mutation_blocked", "direct_graphdb_attempts", "direct_graphdb_blocked",
    "repository_expected_hash", "repository_before_hash", "repository_after_hash", "repository_unchanged",
    "upstream_phase03_hash_before", "upstream_phase03_hash_after", "upstream_phase03_unchanged", "status"
  ],
  "properties": {
    "contract_version": {"const": "1.0"},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "stage08_baseline": {"const": "4dc09d9cfb15da3746f108755593ceb9fe805cd7"},
    "phase01_baseline": {"const": "79b7d34125b0c5cb2d5fe8546e1f4e6a95ca8106"},
    "phase02_baseline": {"const": "3ef40b9cfbd657b55d8c5f446cfc247335db87f0"},
    "phase03_baseline": {"const": "06898e8ef3fbe93bd7e7a030f4361c0bef7a76c9"},
    "upstream_verification_mode": {"enum": ["LOCAL_LICENSED", "EXACT_SHA_REMOTE_LICENSED_EVIDENCE"]},
    "authority_type": {"const": "PRODUCTION_EXACT_PHASE03"},
    "publication_id": {"type": "string", "minLength": 1},
    "publication_semantic_hash": {"$ref": "#/$defs/hash"},
    "repository_semantic_hash": {"$ref": "#/$defs/hash"},
    "upstream_phase03_attestation_sha256": {"$ref": "#/$defs/hash"},
    "upstream_phase03_diagnostic_package_hash": {"$ref": "#/$defs/hash"},
    "upstream_phase03_issues_total": {"$ref": "#/$defs/count"},
    "governance_contract_hash": {"$ref": "#/$defs/hash"},
    "production_workspace_hash": {"$ref": "#/$defs/hash"},
    "production_workspace_revision": {"$ref": "#/$defs/count"},
    "production_proposals_created": {"$ref": "#/$defs/count"},
    "production_reviews_approved": {"$ref": "#/$defs/count"},
    "production_reviews_rejected": {"$ref": "#/$defs/count"},
    "production_reviews_deferred": {"$ref": "#/$defs/count"},
    "production_amendment_requests": {"$ref": "#/$defs/count"},
    "controlled_fixture_hash": {"$ref": "#/$defs/hash"},
    "controlled_fixture_diagnostic_package_hash": {"$ref": "#/$defs/hash"},
    "controlled_fixture_status": {"const": "CONTROLLED_DIAGNOSTIC_FIXTURE"},
    "controlled_scenarios_total": {"$ref": "#/$defs/count"},
    "controlled_scenarios_passed": {"$ref": "#/$defs/count"},
    "authority_laundering_attempts": {"$ref": "#/$defs/count"},
    "authority_laundering_blocked": {"$ref": "#/$defs/count"},
    "illegal_transition_attempts": {"$ref": "#/$defs/count"},
    "illegal_transition_blocked": {"$ref": "#/$defs/count"},
    "stale_binding_attempts": {"$ref": "#/$defs/count"},
    "stale_binding_blocked": {"$ref": "#/$defs/count"},
    "replay_attempts": {"$ref": "#/$defs/count"},
    "replay_blocked": {"$ref": "#/$defs/count"},
    "concurrency_attempts": {"$ref": "#/$defs/count"},
    "concurrency_blocked": {"$ref": "#/$defs/count"},
    "csrf_attempts": {"$ref": "#/$defs/count"},
    "csrf_blocked": {"$ref": "#/$defs/count"},
    "xss_attempts": {"$ref": "#/$defs/count"},
    "xss_blocked": {"$ref": "#/$defs/count"},
    "rdf_mutation_attempts": {"$ref": "#/$defs/count"},
    "rdf_mutation_blocked": {"$ref": "#/$defs/count"},
    "direct_graphdb_attempts": {"$ref": "#/$defs/count"},
    "direct_graphdb_blocked": {"$ref": "#/$defs/count"},
    "repository_expected_hash": {"$ref": "#/$defs/hash"},
    "repository_before_hash": {"$ref": "#/$defs/hash"},
    "repository_after_hash": {"$ref": "#/$defs/hash"},
    "repository_unchanged": {"type": "boolean"},
    "upstream_phase03_hash_before": {"$ref": "#/$defs/hash"},
    "upstream_phase03_hash_after": {"$ref": "#/$defs/hash"},
    "upstream_phase03_unchanged": {"type": "boolean"},
    "status": {"enum": ["APPLICATION_HUMAN_GOVERNANCE_VERIFIED", "FAILED"]}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "count": {"type": "integer", "minimum": 0}
  }
}
