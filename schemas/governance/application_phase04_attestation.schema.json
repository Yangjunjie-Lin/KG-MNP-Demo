    "phase03_attestation_hash": {"$ref": "#/$defs/hash"},
    "diagnostic_package_hash": {"$ref": "#/$defs/hash"},
    "governance_contract_hash": {"$ref": "#/$defs/hash"},
    "governance_workspace_hash": {"$ref": "#/$defs/hash"},
    "proposals_created": {"$ref": "#/$defs/count"}, "proposals_submitted": {"$ref": "#/$defs/count"},
    "reviews_approved": {"$ref": "#/$defs/count"}, "reviews_rejected": {"$ref": "#/$defs/count"}, "reviews_deferred": {"$ref": "#/$defs/count"},
    "approved_amendment_requests": {"$ref": "#/$defs/count"},
    "illegal_transition_attempts": {"$ref": "#/$defs/count"}, "illegal_transition_blocked": {"$ref": "#/$defs/count"},
    "stale_binding_attempts": {"$ref": "#/$defs/count"}, "stale_binding_blocked": {"$ref": "#/$defs/count"},
    "replay_attempts": {"$ref": "#/$defs/count"}, "replay_blocked": {"$ref": "#/$defs/count"},
    "concurrency_conflicts": {"$ref": "#/$defs/count"}, "concurrency_conflicts_blocked": {"$ref": "#/$defs/count"},
    "csrf_attempts": {"$ref": "#/$defs/count"}, "csrf_blocked": {"$ref": "#/$defs/count"},
    "xss_attempts": {"$ref": "#/$defs/count"}, "xss_blocked": {"$ref": "#/$defs/count"},
