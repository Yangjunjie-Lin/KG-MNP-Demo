{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/governance/governance-workspace/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "workspace_id", "authority_binding", "events", "workspace_revision", "head_event_hash", "workspace_hash", "status"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "workspace_id": {"type": "string", "pattern": "^urn:kg-mnp:(?:governance-workspace|test-fixture:phase04:governance-workspace):[0-9a-f]{64}$"},
    "authority_binding": {
      "type": "object", "additionalProperties": false,
      "required": ["authority_type", "publication_id", "publication_semantic_hash", "repository_semantic_hash", "upstream_phase03_attestation_sha256", "upstream_phase03_diagnostic_package_hash"],
      "properties": {
        "authority_type": {"enum": ["PRODUCTION_EXACT_PHASE03", "CONTROLLED_TEST_HARNESS"]},
        "publication_id": {"type": "string"}, "publication_semantic_hash": {"$ref": "#/$defs/hash"},
        "repository_semantic_hash": {"$ref": "#/$defs/hash"},
        "upstream_phase03_attestation_sha256": {"$ref": "#/$defs/hash"},
        "upstream_phase03_diagnostic_package_hash": {"$ref": "#/$defs/hash"}
      }
    },
    "events": {"type": "array", "items": {"type": "object"}},
    "workspace_revision": {"type": "integer", "minimum": 0},
    "head_event_hash": {"type": "string", "pattern": "^(GENESIS|[0-9a-f]{64})$"},
    "workspace_hash": {"$ref": "#/$defs/hash"},
    "status": {"const": "GOVERNANCE_WORKSPACE_ACTIVE"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
