{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/workbench/attestation/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "commit_sha", "foundation_stage08_baseline", "phase01_baseline_sha", "phase01_attestation_hash", "phase01_attestation_status", "publication_id", "publication_semantic_hash", "repository_hash_expected", "repository_hash_before", "repository_hash_after", "repository_unchanged", "query_registry_hash", "frontend_build_hash", "runtime_policy_hash", "browser_name", "browser_version", "browser_revision", "golden_scenario_count", "golden_scenario_passed", "xss_attack_count", "xss_attack_blocked", "relay_attack_count", "relay_attack_blocked", "authority_tamper_attack_count", "authority_tamper_attack_blocked", "external_request_count", "direct_graphdb_access_attempt_count", "direct_graphdb_access_blocked_count", "service_worker_count", "local_storage_entry_count", "indexed_db_count", "result_fidelity_status", "traceability_view_status", "status"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "foundation_stage08_baseline": {"const": "4dc09d9cfb15da3746f108755593ceb9fe805cd7"},
    "phase01_baseline_sha": {"const": "79b7d34125b0c5cb2d5fe8546e1f4e6a95ca8106"},
    "phase01_attestation_hash": {"$ref": "#/$defs/hash"},
    "phase01_attestation_status": {"const": "APPLICATION_READONLY_VERIFIED"},
    "publication_id": {"type": "string"},
    "publication_semantic_hash": {"$ref": "#/$defs/hash"},
    "repository_hash_expected": {"$ref": "#/$defs/hash"},
    "repository_hash_before": {"$ref": "#/$defs/hash"},
    "repository_hash_after": {"$ref": "#/$defs/hash"},
    "repository_unchanged": {"const": true},
    "query_registry_hash": {"$ref": "#/$defs/hash"},
    "frontend_build_hash": {"$ref": "#/$defs/hash"},
    "runtime_policy_hash": {"$ref": "#/$defs/hash"},
    "browser_name": {"const": "chromium"},
    "browser_version": {"type": "string", "minLength": 1},
    "browser_revision": {"type": "string", "minLength": 1},
    "golden_scenario_count": {"const": 4},
    "golden_scenario_passed": {"const": 4},
    "xss_attack_count": {"type": "integer", "minimum": 10},
    "xss_attack_blocked": {"type": "integer", "minimum": 10},
    "relay_attack_count": {"type": "integer", "minimum": 10},
    "relay_attack_blocked": {"type": "integer", "minimum": 10},
    "authority_tamper_attack_count": {"type": "integer", "minimum": 6},
    "authority_tamper_attack_blocked": {"type": "integer", "minimum": 6},
    "external_request_count": {"const": 0},
    "direct_graphdb_access_attempt_count": {"type": "integer", "minimum": 1},
    "direct_graphdb_access_blocked_count": {"type": "integer", "minimum": 1},
    "service_worker_count": {"const": 0},
    "local_storage_entry_count": {"const": 0},
    "indexed_db_count": {"const": 0},
    "result_fidelity_status": {"const": "PASS"},
    "traceability_view_status": {"const": "PASS"},
    "status": {"const": "APPLICATION_WORKBENCH_VERIFIED"}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
