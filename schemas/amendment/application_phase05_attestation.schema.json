{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/amendment/application-phase05-attestation/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "commit_sha", "upstream_phase04_attestation_sha256",
    "upstream_phase04_workspace_hash", "production_pending_amendments",
    "production_reentry_cycles", "production_new_publications",
    "controlled_fixture_hash", "controlled_reentry_cycles",
    "controlled_republication_cycles", "determinism_runs", "determinism_passed",
    "unauthorized_amendment_attempts", "unauthorized_amendment_blocked",
    "scope_violation_attempts", "scope_violation_blocked",
    "semantic_mismatch_attempts", "semantic_mismatch_blocked",
    "auto_confirm_attempts", "auto_confirm_blocked",
    "direct_rdf_mutation_attempts", "direct_rdf_mutation_blocked",
    "graphdb_inplace_mutation_attempts", "graphdb_inplace_mutation_blocked",
    "tbox_amendment_attempts", "tbox_amendment_blocked",
    "replay_attempts", "replay_blocked", "old_tbox_hash", "new_tbox_hash",
    "old_shacl_hash", "new_shacl_hash", "old_abox_hash", "new_abox_hash",
    "old_publication_hash", "new_publication_hash", "old_webvowl_hash",
    "new_webvowl_hash", "old_repository_before_hash",
    "old_repository_after_hash", "new_repository_expected_hash",
    "new_repository_actual_hash", "target_diagnostic_before",
    "target_diagnostic_after", "status"
  ],
  "properties": {
    "contract_version": {"const": "1.0"},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "upstream_phase04_attestation_sha256": {"$ref": "#/$defs/hash"},
    "upstream_phase04_workspace_hash": {"$ref": "#/$defs/hash"},
    "production_pending_amendments": {"$ref": "#/$defs/count"},
    "production_reentry_cycles": {"$ref": "#/$defs/count"},
    "production_new_publications": {"$ref": "#/$defs/count"},
    "controlled_fixture_hash": {"$ref": "#/$defs/hash"},
    "controlled_reentry_cycles": {"$ref": "#/$defs/count"},
    "controlled_republication_cycles": {"$ref": "#/$defs/count"},
    "determinism_runs": {"$ref": "#/$defs/count"},
    "determinism_passed": {"$ref": "#/$defs/count"},
    "unauthorized_amendment_attempts": {"$ref": "#/$defs/count"},
    "unauthorized_amendment_blocked": {"$ref": "#/$defs/count"},
    "scope_violation_attempts": {"$ref": "#/$defs/count"},
    "scope_violation_blocked": {"$ref": "#/$defs/count"},
    "semantic_mismatch_attempts": {"$ref": "#/$defs/count"},
    "semantic_mismatch_blocked": {"$ref": "#/$defs/count"},
    "auto_confirm_attempts": {"$ref": "#/$defs/count"},
    "auto_confirm_blocked": {"$ref": "#/$defs/count"},
    "direct_rdf_mutation_attempts": {"$ref": "#/$defs/count"},
    "direct_rdf_mutation_blocked": {"$ref": "#/$defs/count"},
    "graphdb_inplace_mutation_attempts": {"$ref": "#/$defs/count"},
    "graphdb_inplace_mutation_blocked": {"$ref": "#/$defs/count"},
    "tbox_amendment_attempts": {"$ref": "#/$defs/count"},
    "tbox_amendment_blocked": {"$ref": "#/$defs/count"},
    "replay_attempts": {"$ref": "#/$defs/count"},
    "replay_blocked": {"$ref": "#/$defs/count"},
    "old_tbox_hash": {"$ref": "#/$defs/hash"},
    "new_tbox_hash": {"$ref": "#/$defs/hash"},
    "old_shacl_hash": {"$ref": "#/$defs/hash"},
    "new_shacl_hash": {"$ref": "#/$defs/hash"},
    "old_abox_hash": {"$ref": "#/$defs/hash"},
    "new_abox_hash": {"$ref": "#/$defs/hash"},
    "old_publication_hash": {"$ref": "#/$defs/hash"},
    "new_publication_hash": {"$ref": "#/$defs/hash"},
    "old_webvowl_hash": {"$ref": "#/$defs/hash"},
    "new_webvowl_hash": {"$ref": "#/$defs/hash"},
    "old_repository_before_hash": {"$ref": "#/$defs/hash"},
    "old_repository_after_hash": {"$ref": "#/$defs/hash"},
    "new_repository_expected_hash": {"$ref": "#/$defs/hash"},
    "new_repository_actual_hash": {"$ref": "#/$defs/hash"},
    "target_diagnostic_before": {"type": ["object", "null"]},
    "target_diagnostic_after": {"type": ["object", "null"]},
    "status": {"const": "APPLICATION_AMENDMENT_REPUBLICATION_VERIFIED"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "count": {"type": "integer", "minimum": 0}
  }
}
