{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://kg-mnp-demo.local/schemas/canonical_business_diagram_v2.schema.json",
  "title": "KG-MNP Canonical Business Diagram v2",
  "description": "Fixed monochrome business-diagram geometry, routing, labels, and auxiliary marks.",
  "type": "object",
  "required": [
    "version",
    "view_id",
    "canvas",
    "style",
    "layers",
    "nodes",
    "buses",
    "edges",
    "markers"
  ],
  "additionalProperties": false,
  "properties": {
    "$schema": { "type": "string", "minLength": 1 },
    "version": { "const": "2.0" },
    "view_id": { "const": "KG_MNP_CANONICAL_BUSINESS_DIAGRAM" },
    "canvas": { "$ref": "#/$defs/canvas" },
    "style": { "$ref": "#/$defs/style" },
    "layers": {
      "type": "array",
      "items": { "$ref": "#/$defs/layer" },
      "minItems": 5,
      "maxItems": 5
    },
    "nodes": {
      "type": "array",
      "items": { "$ref": "#/$defs/node" },
      "minItems": 27,
      "maxItems": 27
    },
    "buses": {
      "type": "array",
      "items": { "$ref": "#/$defs/bus" },
      "minItems": 1,
      "maxItems": 1
    },
    "edges": {
      "type": "array",
      "items": { "$ref": "#/$defs/edge" },
      "minItems": 29,
      "maxItems": 29
    },
    "markers": {
      "type": "array",
      "items": { "$ref": "#/$defs/marker" },
      "minItems": 1,
      "maxItems": 1
    }
  },
  "$defs": {
    "businessLayerId": {
      "type": "string",
      "enum": [
        "USER_IDENTITY",
        "ACCOUNT_BILLING",
        "SERVICE_OFFERING",
        "PORTABILITY_PROCESS",
        "QUALIFICATION_COMPLIANCE"
      ]
    },
    "businessRoleId": {
      "type": "string",
      "enum": [
        "USER",
        "VERIFICATION",
        "MOBILE_NUMBER_IDENTITY",
        "OPERATOR_CURRENT",
        "ACCOUNT",
        "BILL",
        "PAYMENT",
        "TARIFF_PLAN",
        "CONTRACT",
        "BROADBAND",
        "VALUE_ADDED_SERVICE",
        "USER_RIGHT",
        "PORT_REQUEST",
        "MOBILE_NUMBER_PORT",
        "OPERATOR_DONOR",
        "OPERATOR_RECIPIENT",
        "PORT_STEP",
        "AUTH_CODE",
        "EXCEPTION_EVENT",
        "IMPACT",
        "ELIGIBILITY_CONDITION",
        "REGULATION_RULE",
        "SAFETY_CHECK",
        "BLOCK_REASON",
        "REMEDIATION_ACTION",
        "EVIDENCE",
        "OPERATOR_EVIDENCE"
      ]
    },
    "port": {
      "type": "string",
      "enum": ["LEFT", "RIGHT", "TOP", "BOTTOM"]
    },
    "canonicalPath": {
      "type": "string",
      "minLength": 7,
      "pattern": "^M(?:[ 0-9.\\-]|M|H|V)+$"
    },
    "canvas": {
      "type": "object",
      "required": ["width", "height", "view_box", "preserve_aspect_ratio"],
      "additionalProperties": false,
      "properties": {
        "width": { "const": 1664 },
        "height": { "const": 900 },
        "view_box": { "const": "0 0 1664 900" },
        "preserve_aspect_ratio": { "const": "xMidYMid meet" }
      }
    },
    "style": {
      "type": "object",
      "required": [
        "canvas_background",
        "layer_background",
        "layer_border",
        "layer_border_width",
        "layer_separator_width",
        "node_background",
        "node_border",
        "node_border_width",
        "node_radius",
        "primary_text",
        "secondary_text",
        "edge",
        "edge_width",
        "arrow_fill",
        "label_background",
        "label_border",
        "shadow",
        "gradient",
        "node_text",
        "safety_check",
        "trace"
      ],
      "additionalProperties": false,
      "properties": {
        "canvas_background": { "const": "#ffffff" },
        "layer_background": { "const": "#ffffff" },
        "layer_border": { "const": "#111111" },
        "layer_border_width": { "const": 1.5 },
        "layer_separator_width": { "const": 1.5 },
        "node_background": { "const": "#ffffff" },
        "node_border": { "const": "#111111" },
        "node_border_width": { "const": 1.5 },
        "node_radius": { "const": 0 },
        "primary_text": { "const": "#111111" },
        "secondary_text": { "const": "#111111" },
        "edge": { "const": "#111111" },
        "edge_width": { "const": 1.5 },
        "arrow_fill": { "const": "#111111" },
        "label_background": { "const": "#ffffff" },
        "label_border": { "const": "none" },
        "shadow": { "const": "none" },
        "gradient": { "const": "none" },
        "node_text": {
          "type": "object",
          "required": [
            "zh_font_size",
            "zh_font_weight",
            "en_font_size",
            "en_font_weight"
          ],
          "additionalProperties": false,
          "properties": {
            "zh_font_size": { "const": 18 },
            "zh_font_weight": { "const": 700 },
            "en_font_size": { "const": 15 },
            "en_font_weight": { "const": 400 }
          }
        },
        "safety_check": {
          "type": "object",
          "required": [
            "node_border_width",
            "font_weight",
            "zh_font_size",
            "en_font_size"
          ],
          "additionalProperties": false,
          "properties": {
            "node_border_width": { "const": 3.5 },
            "font_weight": { "const": 700 },
            "zh_font_size": { "const": 24 },
            "en_font_size": { "const": 19 }
          }
        },
        "trace": {
          "type": "object",
          "required": [
            "active_node_opacity",
            "inactive_node_opacity",
            "active_edge_opacity",
            "inactive_edge_opacity",
            "pass",
            "block",
            "warning"
          ],
          "additionalProperties": false,
          "properties": {
            "active_node_opacity": { "const": 1 },
            "inactive_node_opacity": { "const": 0.16 },
            "active_edge_opacity": { "const": 1 },
            "inactive_edge_opacity": { "const": 0.08 },
            "pass": { "const": "#14532d" },
            "block": { "const": "#7f1d1d" },
            "warning": { "const": "#9a3412" }
          }
        }
      }
    },
    "titleArea": {
      "type": "object",
      "required": ["x", "width"],
      "additionalProperties": false,
      "properties": {
        "x": { "const": 8 },
        "width": { "const": 214 }
      }
    },
    "layer": {
      "type": "object",
      "required": [
        "id",
        "order",
        "titleZh",
        "subtitleLines",
        "x",
        "y",
        "width",
        "height",
        "titleArea",
        "contentX"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/businessLayerId" },
        "order": { "type": "integer", "minimum": 1, "maximum": 5 },
        "titleZh": { "type": "string", "pattern": "^[1-5]\\. [^A-Za-z]+$" },
        "subtitleLines": {
          "type": "array",
          "items": { "type": "string", "minLength": 2 },
          "minItems": 2,
          "maxItems": 2
        },
        "x": { "const": 8 },
        "y": { "type": "integer", "minimum": 0, "maximum": 900 },
        "width": { "const": 1648 },
        "height": { "type": "integer", "minimum": 1, "maximum": 900 },
        "titleArea": { "$ref": "#/$defs/titleArea" },
        "contentX": { "const": 222 }
      }
    },
    "node": {
      "type": "object",
      "required": [
        "id",
        "layerId",
        "labelZh",
        "labelEn",
        "x",
        "y",
        "width",
        "height",
        "styleKey"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/businessRoleId" },
        "layerId": { "$ref": "#/$defs/businessLayerId" },
        "labelZh": { "type": "string", "pattern": "[\\u3400-\\u9fff]" },
        "labelEn": { "type": "string", "pattern": "^[A-Za-z][A-Za-z &-]*$" },
        "x": { "type": "integer", "minimum": 0, "maximum": 1664 },
        "y": { "type": "integer", "minimum": 0, "maximum": 900 },
        "width": { "type": "integer", "minimum": 1, "maximum": 1664 },
        "height": { "type": "integer", "minimum": 1, "maximum": 900 },
        "styleKey": { "enum": ["ordinary", "safety_check"] }
      }
    },
    "bus": {
      "type": "object",
      "required": [
        "id",
        "sourceRole",
        "sourcePort",
        "path",
        "bendCount",
        "edgeIds"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" },
        "sourceRole": { "$ref": "#/$defs/businessRoleId" },
        "sourcePort": { "$ref": "#/$defs/port" },
        "path": { "$ref": "#/$defs/canonicalPath" },
        "bendCount": { "type": "integer", "minimum": 0, "maximum": 1 },
        "edgeIds": {
          "type": "array",
          "items": { "type": "string", "pattern": "^struct-[a-z0-9-]+$" },
          "minItems": 2,
          "uniqueItems": true
        }
      }
    },
    "edge": {
      "type": "object",
      "required": [
        "id",
        "fromRole",
        "toRole",
        "sourceRole",
        "targetRole",
        "sourcePort",
        "targetPort",
        "labelZh",
        "path",
        "labelX",
        "labelY",
        "bendCount"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "pattern": "^struct-[a-z0-9-]+$" },
        "fromRole": { "$ref": "#/$defs/businessRoleId" },
        "toRole": { "$ref": "#/$defs/businessRoleId" },
        "sourceRole": { "$ref": "#/$defs/businessRoleId" },
        "targetRole": { "$ref": "#/$defs/businessRoleId" },
        "sourcePort": { "$ref": "#/$defs/port" },
        "targetPort": { "$ref": "#/$defs/port" },
        "labelZh": { "type": "string", "pattern": "[\\u3400-\\u9fff]" },
        "auxiliaryLabelZh": { "type": "string", "pattern": "[\\u3400-\\u9fff]" },
        "path": { "$ref": "#/$defs/canonicalPath" },
        "labelX": { "type": "number", "minimum": 0, "maximum": 1664 },
        "labelY": { "type": "number", "minimum": 0, "maximum": 900 },
        "bendCount": { "type": "integer", "minimum": 0, "maximum": 3 },
        "busId": { "type": "string", "pattern": "^[a-z][a-z0-9-]+$" }
      }
    },
    "rect": {
      "type": "object",
      "required": ["x", "y", "width", "height"],
      "additionalProperties": false,
      "properties": {
        "x": { "type": "number", "minimum": 0, "maximum": 1664 },
        "y": { "type": "number", "minimum": 0, "maximum": 900 },
        "width": { "type": "number", "exclusiveMinimum": 0, "maximum": 1664 },
        "height": { "type": "number", "exclusiveMinimum": 0, "maximum": 900 }
      }
    },
    "markerArrow": {
      "type": "object",
      "required": ["id", "path", "targetRole", "targetPort", "markerEnd"],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "path": { "$ref": "#/$defs/canonicalPath" },
        "targetRole": { "$ref": "#/$defs/businessRoleId" },
        "targetPort": { "$ref": "#/$defs/port" },
        "markerEnd": { "const": true }
      }
    },
    "markerStyle": {
      "type": "object",
      "required": ["stroke", "strokeWidth", "strokeDasharray", "fill"],
      "additionalProperties": false,
      "properties": {
        "stroke": { "const": "#111111" },
        "strokeWidth": { "const": 1.5 },
        "strokeDasharray": { "const": "7 5" },
        "fill": { "const": "none" }
      }
    },
    "marker": {
      "type": "object",
      "required": [
        "id",
        "type",
        "anchorRole",
        "rect",
        "labelZh",
        "labelX",
        "labelY",
        "arrows",
        "style"
      ],
      "additionalProperties": false,
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "type": { "const": "PRIMARY_SECONDARY_CARD" },
        "anchorRole": { "$ref": "#/$defs/businessRoleId" },
        "rect": { "$ref": "#/$defs/rect" },
        "labelZh": { "type": "string", "pattern": "[\\u3400-\\u9fff]" },
        "labelX": { "type": "number", "minimum": 0, "maximum": 1664 },
        "labelY": { "type": "number", "minimum": 0, "maximum": 900 },
        "arrows": {
          "type": "array",
          "items": { "$ref": "#/$defs/markerArrow" },
          "minItems": 2,
          "maxItems": 2
        },
        "style": { "$ref": "#/$defs/markerStyle" }
      }
    }
  }
}
