{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/webvowl/runtime-policy/1.0",
  "title": "KG-MNP WebVOWL Runtime Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "runtime_id", "runtime_version", "webvowl", "owl2vowl", "source_tree_hashes", "network", "visualization", "conversion", "normalization_exclusion_policy", "images", "build_dependencies", "license", "retrieval"],
  "properties": {
    "contract_version": {"const": "1.0"}, "runtime_id": {"const": "kg-mnp-webvowl-runtime"}, "runtime_version": {"const": "1.0.0"},
    "webvowl": {"$ref": "#/$defs/upstream"}, "owl2vowl": {"$ref": "#/$defs/upstream"},
    "source_tree_hashes": {"type":"object","additionalProperties":false,"required":["webvowl","owl2vowl"],"properties":{"webvowl":{"type":"string","pattern":"^[0-9a-f]{40}$"},"owl2vowl":{"type":"string","pattern":"^[0-9a-f]{40}$"}}},
    "network": {"type":"object","additionalProperties":false,"required":["bind_host","port","external_exposure","runtime_internet_access"],"properties":{"bind_host":{"const":"127.0.0.1"},"port":{"const":8080},"external_exposure":{"const":"FORBIDDEN"},"runtime_internet_access":{"const":"FORBIDDEN"}}},
    "visualization": {"type":"object","additionalProperties":false,"required":["scope","abox_visualization","graphdb_is_semantic_authority","ontology_is_semantic_authority"],"properties":{"scope":{"const":"TBOX_ONLY"},"abox_visualization":{"const":"FORBIDDEN"},"graphdb_is_semantic_authority":{"const":false},"ontology_is_semantic_authority":{"const":true}}},
    "conversion": {"type":"object","additionalProperties":false,"required":["source","remote_iri_loading","external_import_resolution","deterministic_normalization","network_mode","audited_raw_fixture","audited_source_tbox_sha256","audited_raw_sha256","audited_normalized_sha256"],"properties":{"source":{"const":"STAGE03_ROOT_PLUS_RUNTIME_DEPENDENCIES"},"remote_iri_loading":{"const":"FORBIDDEN"},"external_import_resolution":{"const":"FORBIDDEN"},"deterministic_normalization":{"const":"REQUIRED"},"network_mode":{"const":"none"},"audited_raw_fixture":{"const":"examples/publication/fixtures/owl2vowl-0.3.7-raw.json"},"audited_source_tbox_sha256":{"const":"4d66605486f5f581a8d83344e2144639e1c03a8bc8320d1bc30e69ab9058da95"},"audited_raw_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},"audited_normalized_sha256":{"type":"string","pattern":"^[0-9a-f]{64}$"}}},
    "normalization_exclusion_policy": {"type":"object","additionalProperties":false,"required":["class_individuals"],"properties":{"class_individuals":{"type":"object","additionalProperties":false,"required":["field","action","allowed_iri_prefix","reason","evidence"],"properties":{"field":{"const":"classAttribute[].individuals"},"action":{"const":"REMOVE_FROM_PRESENTATION_PROJECTION"},"allowed_iri_prefix":{"const":"https://yangjunjie-lin.github.io/KG-MNP-Demo/ontology/terms#Code-"},"reason":{"type":"string","minLength":1},"evidence":{"const":"ontology/mnp-code-list.ttl"}}}}},
    "images": {"type":"object","additionalProperties":false,"required":["maven","node","tomcat_jdk","tomcat_jre"],"patternProperties":{"^.+$":{"$ref":"#/$defs/image"}}},
    "build_dependencies": {"type":"object","additionalProperties":false,"required":["webvowl_npm_shrinkwrap"],"properties":{"webvowl_npm_shrinkwrap":{"type":"object","additionalProperties":false,"required":["path","sha256","install_mode"],"properties":{"path":{"const":"deploy/webvowl/webvowl-npm-shrinkwrap.json"},"sha256":{"const":"74c5094525121337d6b71d0862ec9543a0356e536b00fe67b45f03d031f0fdda"},"install_mode":{"const":"NPM_CI"}}}}},
    "license": {"type":"object","additionalProperties":false,"required":["webvowl","owl2vowl"],"properties":{"webvowl":{"const":"MIT"},"owl2vowl":{"const":"MIT"}}},
    "retrieval": {"type":"object","additionalProperties":false,"required":["method","fallback_branch"],"properties":{"method":{"const":"ISOLATED_GIT_FETCH_EXACT_COMMIT"},"fallback_branch":{"const":"FORBIDDEN"}}}
  },
  "$defs": {"upstream":{"type":"object","additionalProperties":false,"required":["repository","commit_sha","source_version"],"properties":{"repository":{"type":"string","format":"uri"},"commit_sha":{"type":"string","pattern":"^[0-9a-f]{40}$"},"source_version":{"type":"string","minLength":1}}},"image":{"type":"object","additionalProperties":false,"required":["reference","digest"],"properties":{"reference":{"type":"string","pattern":"^[A-Za-z0-9./:_-]+$"},"digest":{"type":"string","pattern":"^sha256:[0-9a-f]{64}$"}}}}
}
