{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-manifest/1.0",
  "title": "KG-MNP Stage 06 Compilation Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "contract_version", "compilation_id", "compilation_semantic_hash",
    "compiler_policy_id", "compiler_policy_version", "compiler_policy_hash",
    "compiler_version", "source_package_id", "source_package_semantic_hash",
    "source_proposal_id", "source_proposal_hash", "source_review_decision_log_id",
    "source_review_decision_log_hash", "ontology_baseline_id", "ontology_version",
    "ontology_release_source_hash", "graph_iris", "artifact_manifest",
    "asserted_fact_count", "inferred_fact_count", "inference_materialized",
    "provenance_record_count", "review_record_count", "shacl_status",
    "shacl_violation_count", "shacl_warning_count", "shacl_info_count",
    "owl_consistency_status", "release_status"
  ],
  "properties": {
    "contract_version": {"const": "1.0"},
    "compilation_id": {"type": "string", "pattern": "^urn:kg-mnp:compilation:[0-9a-f]{64}$"},
    "compilation_semantic_hash": {"$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/common/1.0#/$defs/SHA256"},
    "compiler_policy_id": {"type": "string", "minLength": 1},
    "compiler_policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "compiler_policy_hash": {"$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/common/1.0#/$defs/SHA256"},
    "compiler_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "source_package_id": {"type": "string", "pattern": "^urn:kg-mnp:confirmed-modeling-package:[0-9a-f]{64}$"},
    "source_package_semantic_hash": {"$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/common/1.0#/$defs/SHA256"},
    "source_proposal_id": {"type": "string", "pattern": "^urn:kg-mnp:modeling-proposal:[0-9a-f]{64}$"},
    "source_proposal_hash": {"$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/common/1.0#/$defs/SHA256"},
    "source_review_decision_log_id": {"type": "string", "pattern": "^urn:kg-mnp:review-decision-log:[0-9a-f]{64}$"},
    "source_review_decision_log_hash": {"$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/common/1.0#/$defs/SHA256"},
    "ontology_baseline_id": {"type": "string", "minLength": 1},
    "ontology_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "ontology_release_source_hash": {"$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/common/1.0#/$defs/SHA256"},
    "graph_iris": {"$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/common/1.0#/$defs/GraphIRIManifest"},
    "artifact_manifest": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/common/1.0#/$defs/ArtifactRecord"}
    },
    "asserted_fact_count": {"type": "integer", "minimum": 0},
    "inferred_fact_count": {"const": 0},
    "inference_materialized": {"const": false},
    "provenance_record_count": {"type": "integer", "minimum": 0},
    "review_record_count": {"type": "integer", "minimum": 0},
    "shacl_status": {"enum": ["CONFORMS", "VIOLATION", "FAILED"]},
    "shacl_violation_count": {"type": "integer", "minimum": 0},
    "shacl_warning_count": {"type": "integer", "minimum": 0},
    "shacl_info_count": {"type": "integer", "minimum": 0},
    "owl_consistency_status": {"enum": ["CONSISTENT", "INCONSISTENT", "FAILED", "UNKNOWN", "NOT_RUN"]},
    "release_status": {"enum": ["FORMALLY_VALIDATED", "FAILED"]}
  }
}
