{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/owl-consistency-report/1.0",
  "title": "KG-MNP Stage 06 OWL Consistency Report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "status", "consistent", "reasoner", "robot_version", "robot_jar_sha256",
    "ontology_release_source_hash", "abox_semantic_hash",
    "combined_input_semantic_hash", "source_package_hash",
    "hermit_dependency_version", "exit_code"
  ],
  "properties": {
    "status": {"enum": ["CONSISTENT", "INCONSISTENT", "FAILED", "UNKNOWN", "NOT_RUN"]},
    "consistent": {"type": "boolean"},
    "reasoner": {"type": "string", "minLength": 1},
    "robot_version": {"type": "string", "minLength": 1},
    "robot_jar_sha256": {"$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/common/1.0#/$defs/SHA256"},
    "ontology_release_source_hash": {"$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/common/1.0#/$defs/SHA256"},
    "abox_semantic_hash": {"$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/common/1.0#/$defs/SHA256"},
    "combined_input_semantic_hash": {"$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/common/1.0#/$defs/SHA256"},
    "source_package_hash": {"$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/common/1.0#/$defs/SHA256"},
    "hermit_dependency_version": {"type": "string", "minLength": 1},
    "exit_code": {"type": ["integer", "null"]}
  },
  "allOf": [
    {
      "if": {"properties": {"status": {"const": "CONSISTENT"}}, "required": ["status"]},
      "then": {
        "properties": {
          "consistent": {"const": true},
          "exit_code": {"const": 0}
        }
      },
      "else": {"properties": {"consistent": {"const": false}}}
    }
  ]
}
