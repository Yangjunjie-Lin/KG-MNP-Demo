{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compiler-policy/1.0",
  "title": "KG-MNP Stage 06 Compiler Policy",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "compiler_policy_id", "compiler_policy_version", "compiler_version", "input_package_status", "blocked_package_policy", "schema_delta_policy", "candidate_compilation", "asserted_graph_policy", "serialization", "shacl", "owl_consistency", "graph_separation"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "compiler_policy_id": {"type": "string", "minLength": 1},
    "compiler_policy_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "compiler_version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+$"},
    "input_package_status": {"const": "READY_FOR_COMPILATION"},
    "blocked_package_policy": {"const": "REJECT"},
    "schema_delta_policy": {"const": "FORBIDDEN"},
    "candidate_compilation": {"type": "object", "additionalProperties": {"type": "string"}},
    "asserted_graph_policy": {"type": "object", "additionalProperties": {"type": "string"}},
    "serialization": {"type": "object", "additionalProperties": {"type": "string"}},
    "shacl": {"type": "object", "additionalProperties": true},
    "owl_consistency": {"type": "object", "additionalProperties": true},
    "graph_separation": {"type": "object", "additionalProperties": {"type": "boolean"}}
  }
}
