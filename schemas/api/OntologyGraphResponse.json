{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "OntologyGraphResponse",
  "type": "object",
  "additionalProperties": false,
  "required": ["nodes", "edges"],
  "properties": {
    "nodes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id"],
        "properties": {
          "id": { "type": "string" },
          "label": { "type": "string" },
          "local_name": { "type": "string" },
          "type": { "type": "string" },
          "module": { "type": ["string", "null"] }
        }
      }
    },
    "edges": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["source", "predicate", "target"],
        "properties": {
          "source": { "type": "string" },
          "predicate": { "type": "string" },
          "target": { "type": "string" },
          "property_iri": { "type": "string" }
        }
      }
    }
  }
}
