{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "WhatIfResponse",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "baseline",
    "scenario",
    "decision_change",
    "rule_changes",
    "reason_changes",
    "evidence_changes",
    "trace_changes"
  ],
  "properties": {
    "schema_version": { "type": "string" },
    "baseline": { "type": "object" },
    "scenario": { "type": "object" },
    "changes": { "type": "object" },
    "decision_changed": { "type": "boolean" },
    "decision_change": {
      "type": "object",
      "additionalProperties": false,
      "required": ["changed", "from", "to"],
      "properties": {
        "changed": { "type": "boolean" },
        "from": { "type": ["string", "null"] },
        "to": { "type": ["string", "null"] }
      }
    },
    "rule_changes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["rule_id", "changed"],
        "properties": {
          "rule_id": { "type": "string" },
          "version_before": { "type": ["string", "null"] },
          "version_after": { "type": ["string", "null"] },
          "status_before": { "type": ["string", "null"] },
          "status_after": { "type": ["string", "null"] },
          "changed": { "type": "boolean" },
          "change_kind": { "type": "string" }
        }
      }
    },
    "reason_changes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "removed"],
      "properties": {
        "added": { "type": "array", "items": { "type": "string" } },
        "removed": { "type": "array", "items": { "type": "string" } }
      }
    },
    "evidence_changes": {
      "type": "object",
      "additionalProperties": false,
      "required": ["added", "removed", "modified"],
      "properties": {
        "added": { "type": "array" },
        "removed": { "type": "array" },
        "modified": { "type": "array" }
      }
    },
    "trace_changes": {
      "type": "object",
      "properties": {
        "baseline_edge_count": { "type": "integer" },
        "scenario_edge_count": { "type": "integer" },
        "baseline_node_count": { "type": "integer" },
        "scenario_node_count": { "type": "integer" },
        "edge_count_delta": { "type": "integer" },
        "node_count_delta": { "type": "integer" }
      }
    }
  }
}
