{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/diagnostics/diagnostic-attestation/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "commit_sha", "stage08_baseline", "phase01_baseline", "phase02_baseline", "publication_id", "publication_semantic_hash", "phase01_attestation_hash", "phase02_attestation_hash", "query_registry_hash", "repository_expected_hash", "repository_before_hash", "repository_after_hash", "repository_unchanged", "diagnostic_policy_hash", "diagnostic_package_hash", "issues_total", "issues_by_classification", "requirements_evaluated", "constraints_evaluated", "controlled_scenarios_total", "controlled_scenarios_passed", "determinism_runs", "determinism_passed", "permutation_attacks", "permutation_passed", "authority_tamper_attempts", "authority_tamper_blocked", "missingness_attacks", "missingness_expected_results", "conflict_attacks", "conflict_expected_results", "evidence_attacks", "evidence_expected_results", "xss_attempts", "xss_blocked", "external_requests", "direct_graphdb_attempts", "direct_graphdb_blocked", "status"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "commit_sha": {"type": "string", "pattern": "^[0-9a-f]{40}$"},
    "stage08_baseline": {"const": "4dc09d9cfb15da3746f108755593ceb9fe805cd7"},
    "phase01_baseline": {"const": "79b7d34125b0c5cb2d5fe8546e1f4e6a95ca8106"},
    "phase02_baseline": {"const": "3ef40b9cfbd657b55d8c5f446cfc247335db87f0"},
    "publication_id": {"type": "string", "minLength": 1},
    "publication_semantic_hash": {"$ref": "#/$defs/hash"},
    "phase01_attestation_hash": {"$ref": "#/$defs/hash"},
    "phase02_attestation_hash": {"$ref": "#/$defs/hash"},
    "query_registry_hash": {"$ref": "#/$defs/hash"},
    "repository_expected_hash": {"$ref": "#/$defs/hash"},
    "repository_before_hash": {"$ref": "#/$defs/hash"},
    "repository_after_hash": {"$ref": "#/$defs/hash"},
    "repository_unchanged": {"type": "boolean"},
    "diagnostic_policy_hash": {"$ref": "#/$defs/hash"},
    "diagnostic_package_hash": {"$ref": "#/$defs/hash"},
    "issues_total": {"type": "integer", "minimum": 0},
    "issues_by_classification": {"type": "object", "additionalProperties": {"type": "integer", "minimum": 0}},
    "requirements_evaluated": {"type": "integer", "minimum": 0},
    "constraints_evaluated": {"type": "integer", "minimum": 0},
    "controlled_scenarios_total": {"type": "integer", "minimum": 0},
    "controlled_scenarios_passed": {"type": "integer", "minimum": 0},
    "determinism_runs": {"type": "integer", "minimum": 0},
    "determinism_passed": {"type": "boolean"},
    "permutation_attacks": {"type": "integer", "minimum": 0},
    "permutation_passed": {"type": "boolean"},
    "authority_tamper_attempts": {"type": "integer", "minimum": 0},
    "authority_tamper_blocked": {"type": "integer", "minimum": 0},
    "missingness_attacks": {"type": "integer", "minimum": 0},
    "missingness_expected_results": {"type": "integer", "minimum": 0},
    "conflict_attacks": {"type": "integer", "minimum": 0},
    "conflict_expected_results": {"type": "integer", "minimum": 0},
    "evidence_attacks": {"type": "integer", "minimum": 0},
    "evidence_expected_results": {"type": "integer", "minimum": 0},
    "xss_attempts": {"type": "integer", "minimum": 0},
    "xss_blocked": {"type": "integer", "minimum": 0},
    "external_requests": {"type": "integer", "minimum": 0},
    "direct_graphdb_attempts": {"type": "integer", "minimum": 0},
    "direct_graphdb_blocked": {"type": "integer", "minimum": 0},
    "status": {"enum": ["APPLICATION_DIAGNOSTICS_VERIFIED", "FAILED"]}
  },
  "$defs": {"hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"}}
}
