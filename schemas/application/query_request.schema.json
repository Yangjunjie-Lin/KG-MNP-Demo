{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/application/query-request/1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["contract_version", "query_id", "parameters"],
  "properties": {
    "contract_version": {"const": "1.0"},
    "query_id": {"type": "string", "pattern": "^[a-z][a-z0-9.-]{2,63}$"},
    "parameters": {"$ref": "#/$defs/parameters"}
  },
  "$defs": {
    "rdfTerm": {
      "oneOf": [
        {
          "type": "object", "additionalProperties": false,
          "required": ["term_type", "value"],
          "properties": {"term_type": {"const": "IRI"}, "value": {"type": "string", "maxLength": 2048}}
        },
        {
          "type": "object", "additionalProperties": false,
          "required": ["term_type", "value", "datatype_iri", "language"],
          "properties": {
            "term_type": {"const": "LITERAL"}, "value": {"type": "string", "maxLength": 4096},
            "datatype_iri": {"type": ["string", "null"], "maxLength": 2048},
            "language": {"type": ["string", "null"], "maxLength": 64}
          }
        }
      ]
    },
    "parameters": {
      "type": "object", "additionalProperties": false,
      "properties": {
        "iri": {"type": "string", "maxLength": 2048}, "term": {"type": "string", "maxLength": 2048},
        "subject": {"type": "string", "maxLength": 2048}, "predicate": {"type": "string", "maxLength": 2048},
        "object": {"$ref": "#/$defs/rdfTerm"}, "resource_id": {"type": "string", "maxLength": 2048},
        "source_ref": {"type": "string", "maxLength": 2048}, "evidence_ref": {"type": "string", "maxLength": 2048},
        "limit": {"type": "integer", "minimum": 1, "maximum": 1000},
        "offset": {"type": "integer", "minimum": 0, "maximum": 1000000}
      }
    }
  }
}
