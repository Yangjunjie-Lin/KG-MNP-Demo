{
  "$schema": "https://json-schema.org/draft/2020-12/schema", "$id": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/graphdb/query-suite/1.0",
  "type": "object", "additionalProperties": false, "required": ["contract_version", "queries", "expected", "normalization_policy", "query_suite_hash", "query_suite_id"],
  "properties": {
    "contract_version": {"const": "1.0"}, "query_suite_id": {"type": "string"}, "query_suite_hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "queries": {"type": "object", "minProperties": 10, "patternProperties": {"^[0-9]{2}-[a-z0-9-]+$": {"type": "string"}}, "additionalProperties": false},
    "expected": {"type": "object", "additionalProperties": false, "required": ["named_graphs", "counts", "tbox_module_count", "ask"], "properties": {"named_graphs": {"type": "array", "uniqueItems": true, "items": {"type": "string"}}, "counts": {"type": "object", "patternProperties": {"^.+$": {"type": "integer", "minimum": 0}}, "additionalProperties": false}, "tbox_module_count": {"type": "integer"}, "ask": {"type": "object", "patternProperties": {"^[0-9]{2}-[a-z0-9-]+$": {"type": "boolean"}}, "additionalProperties": false}}},
    "normalization_policy": {"type": "object", "additionalProperties": false, "required": ["encoding", "line_endings", "variables", "rows", "ask"], "properties": {"encoding": {"const": "UTF-8"}, "line_endings": {"const": "LF"}, "variables": {"type": "string"}, "rows": {"type": "string"}, "ask": {"type": "string"}}}
  }
}
