{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/graphdb/import-manifest/1.0",
  "type": "object", "additionalProperties": false,
  "required": ["contract_version", "publication_id", "publication_semantic_hash", "graphdb_policy_id", "graphdb_policy_version", "graphdb_policy_hash", "source_compilation_id", "source_compilation_semantic_hash", "source_package_id", "ontology_baseline_id", "ontology_version", "ontology_release_source_hash", "repository_id", "repository_config_byte_hash", "repository_config_semantic_hash", "repository_ruleset", "assembled_dataset_byte_hash", "assembled_dataset_semantic_hash", "forbidden_assertion_set_hash", "forbidden_assertion_count", "tbox_module_count", "tbox_triple_count", "stage06_quad_count", "assembled_quad_count", "named_graphs", "artifact_manifest", "query_suite_id", "query_suite_hash", "release_status"],
  "properties": {
    "contract_version": {"const": "1.0"}, "publication_id": {"type": "string", "pattern": "^urn:kg-mnp:graphdb-publication:[0-9a-f]{64}$"}, "publication_semantic_hash": {"$ref": "#/$defs/hash"},
    "graphdb_policy_id": {"type": "string", "minLength": 1}, "graphdb_policy_version": {"type": "string", "minLength": 1}, "graphdb_policy_hash": {"$ref": "#/$defs/hash"},
    "source_compilation_id": {"type": "string", "minLength": 1}, "source_compilation_semantic_hash": {"$ref": "#/$defs/hash"}, "source_package_id": {"type": "string", "minLength": 1},
    "ontology_baseline_id": {"type": "string", "minLength": 1}, "ontology_version": {"type": "string", "minLength": 1}, "ontology_release_source_hash": {"$ref": "#/$defs/hash"},
    "repository_id": {"type": "string", "pattern": "^kg-mnp-[0-9a-f]{20}$"}, "repository_config_byte_hash": {"$ref": "#/$defs/hash"}, "repository_config_semantic_hash": {"$ref": "#/$defs/hash"}, "repository_ruleset": {"const": "empty"},
    "assembled_dataset_byte_hash": {"$ref": "#/$defs/hash"}, "assembled_dataset_semantic_hash": {"$ref": "#/$defs/hash"}, "forbidden_assertion_set_hash": {"$ref": "#/$defs/hash"}, "forbidden_assertion_count": {"type": "integer", "minimum": 0},
    "tbox_module_count": {"type": "integer", "minimum": 1}, "tbox_triple_count": {"type": "integer", "minimum": 1}, "stage06_quad_count": {"type": "integer", "minimum": 1}, "assembled_quad_count": {"type": "integer", "minimum": 1},
    "named_graphs": {"type": "array", "minItems": 4, "uniqueItems": true, "items": {"type": "string", "format": "uri"}},
    "artifact_manifest": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/artifact"}},
    "query_suite_id": {"type": "string", "pattern": "^urn:kg-mnp:graphdb-query-suite:[0-9a-f]{64}$"}, "query_suite_hash": {"$ref": "#/$defs/hash"}, "release_status": {"const": "READY_FOR_GRAPHDB_IMPORT"}
  },
  "$defs": {
    "hash": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "artifact": {"type": "object", "additionalProperties": false, "required": ["relative_path", "role", "media_type", "byte_sha256", "semantic_sha256", "size_bytes", "artifact_id"], "properties": {
      "relative_path": {"type": "string", "pattern": "^(?!/)(?!.*(?:^|/)\\.\\.(?:/|$))(?!.*\\\\).+$"}, "role": {"type": "string", "minLength": 1}, "media_type": {"type": "string", "minLength": 1},
      "byte_sha256": {"$ref": "#/$defs/hash"}, "semantic_sha256": {"$ref": "#/$defs/hash"}, "size_bytes": {"type": "integer", "minimum": 0}, "artifact_id": {"type": "string", "pattern": "^urn:kg-mnp:artifact:[0-9a-f]{64}$"}
    }}
  }
}
