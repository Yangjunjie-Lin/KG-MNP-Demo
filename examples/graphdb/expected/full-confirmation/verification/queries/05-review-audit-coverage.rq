sor-001>) } } FILTER NOT EXISTS { GRAPH <urn:kg-mnp:graph:review-audit:ceb6df7acf1c239319a7c7d71f47e61f48b31451ced026a402b0351f923adc9a> { ?extraDecision a mnp:ReviewDecision . FILTER(?extraDecision NOT IN (<urn:kg-mnp:review-decision:0d10bdb40395433c26659686d8df1a63415e3ad154e6c93641ae5d6785ae3cf0>, <urn:kg-mnp:review-decision:207c8c40034977d40594dc8170ff3041ccbd758be345fa85d4d1b478a46760f9>, <urn:kg-mnp:review-decision:38854bf468213ccfffeacb7b3ca45487cbc5a2ae395d62031674e703ccd234cb>, <urn:kg-mnp:review-decision:672129df1711864174517686aadfa2e404c076a9f2d0705266467a4c51af4a26>, <urn:kg-mnp:review-decision:b37794a2a434ad5771ef14ddf60eaa3e3aeb60e2e1f6779e4b4c3610d3920530>)) } }  } } ORDER BY ?decision
