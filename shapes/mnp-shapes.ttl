@prefix mnp: <http://example.org/kg-mnp#> .
@prefix sh: <http://www.w3.org/ns/shacl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

#################################################################
# SHACL shapes for MNP instance integrity
#################################################################

mnp:MNPCaseShape a sh:NodeShape ;
    sh:targetClass mnp:MNPCase ;
    sh:property [
        sh:path mnp:caseIdentifier ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "每个携号转网案件必须恰好有一个案件编号 (caseIdentifier)。" ;
    ] ;
    sh:property [
        sh:path mnp:concernsNumber ;
        sh:class mnp:PhoneNumber ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "每个携号转网案件必须恰好关联一个号码 (concernsNumber)。" ;
    ] ;
    sh:property [
        sh:path mnp:requestedBy ;
        sh:class mnp:Subscriber ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "每个携号转网案件必须恰好有一个申请人 (requestedBy)。" ;
    ] ;
    sh:property [
        sh:path mnp:hasCaseEvidence ;
        sh:class mnp:EvidenceRecord ;
        sh:minCount 1 ;
        sh:message "每个携号转网案件必须至少关联一条案件证据 (hasCaseEvidence)。" ;
    ] .

mnp:EvidenceRecordShape a sh:NodeShape ;
    sh:targetClass mnp:EvidenceRecord ;
    sh:property [
        sh:path mnp:hasSourceSystem ;
        sh:class mnp:InformationSystem ;
        sh:minCount 1 ;
        sh:message "证据记录必须标明来源系统 (hasSourceSystem)。" ;
    ] ;
    sh:property [
        sh:path mnp:evidenceGeneratedAt ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:message "证据记录必须有生成时间 (evidenceGeneratedAt)。" ;
    ] ;
    sh:property [
        sh:path mnp:evidenceStatus ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:in ( "VALID" "EXPIRED" "REVOKED" "UNKNOWN" ) ;
        sh:message "证据记录必须有有效状态 (VALID/EXPIRED/REVOKED/UNKNOWN)。" ;
    ] .

mnp:EligibilityAssessmentShape a sh:NodeShape ;
    sh:targetClass mnp:EligibilityAssessment ;
    sh:property [
        sh:path mnp:usesEvidence ;
        sh:class mnp:EvidenceRecord ;
        sh:minCount 1 ;
        sh:message "资格评估必须至少使用一条证据 (usesEvidence)。" ;
    ] ;
    sh:property [
        sh:path mnp:evaluatedByRule ;
        sh:class mnp:EligibilityRule ;
        sh:minCount 1 ;
        sh:message "资格评估必须至少引用一条规则 (evaluatedByRule)。" ;
    ] ;
    sh:property [
        sh:path mnp:dependsOn ;
        sh:class mnp:AssessmentDependency ;
        sh:minCount 1 ;
        sh:message "资格评估必须至少有一个评估依赖 (dependsOn)。" ;
    ] ;
    sh:property [
        sh:path mnp:producesDecision ;
        sh:class mnp:EligibilityDecision ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "资格评估必须恰好产生一个决定 (producesDecision)。" ;
    ] ;
    sh:property [
        sh:path mnp:assessmentTime ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "资格评估必须恰好有一个评估时间 (assessmentTime)。" ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "资格评估使用的证据不属于其对应案件的证据集合。" ;
        sh:select """
            PREFIX mnp: <http://example.org/kg-mnp#>
            SELECT $this ?evidence
            WHERE {
              $this mnp:aboutCase ?case ;
                    mnp:usesEvidence ?evidence .
              FILTER NOT EXISTS {
                ?case mnp:hasCaseEvidence ?evidence .
              }
            }
        """ ;
    ] .

mnp:BlockingDecisionShape a sh:NodeShape ;
    sh:targetClass mnp:BlockingDecision ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "阻塞决定所在评估必须至少产生一个阻塞原因 (producesBlockingReason)。" ;
        sh:select """
            PREFIX mnp: <http://example.org/kg-mnp#>
            SELECT $this WHERE {
                ?assessment mnp:producesDecision $this .
                FILTER NOT EXISTS {
                    ?assessment mnp:producesBlockingReason ?reason .
                }
            }
        """ ;
    ] .

mnp:BlockingReasonShape a sh:NodeShape ;
    sh:targetClass mnp:BlockingReason ;
    sh:property [
        sh:path mnp:reasonCode ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "每个阻塞原因必须具有唯一原因编号 (reasonCode)。" ;
    ] ;
    sh:property [
        sh:path mnp:supportedByEvidence ;
        sh:class mnp:EvidenceRecord ;
        sh:minCount 1 ;
        sh:message "每个阻塞原因必须至少关联一条支持证据 (supportedByEvidence)。" ;
    ] ;
    sh:property [
        sh:path mnp:triggeredByRule ;
        sh:class mnp:EligibilityRule ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "每个阻塞原因必须关联一条触发规则 (triggeredByRule)。" ;
    ] ;
    sh:property [
        sh:path mnp:triggeredByRuleVersion ;
        sh:class mnp:RuleVersion ;
        sh:minCount 1 ;
        sh:maxCount 1 ;
        sh:message "每个阻塞原因必须关联一个实际使用的规则版本 (triggeredByRuleVersion)。" ;
    ] ;
    sh:property [
        sh:path mnp:citesClause ;
        sh:class mnp:RegulatoryClause ;
        sh:minCount 1 ;
        sh:message "每个阻塞原因必须关联监管条款 (citesClause)。" ;
    ] ;
    sh:property [
        sh:path mnp:recommendsAction ;
        sh:class mnp:RemediationAction ;
        sh:minCount 1 ;
        sh:message "每个阻塞原因必须具有处理动作 (recommendsAction)。" ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "阻塞原因引用的证据不是所属资格评估实际使用的证据。" ;
        sh:select """
            PREFIX mnp: <http://example.org/kg-mnp#>
            SELECT $this ?evidence
            WHERE {
              $this mnp:supportedByEvidence ?evidence .
              FILTER NOT EXISTS {
                ?assessment mnp:producesBlockingReason $this ;
                            mnp:usesEvidence ?evidence .
              }
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "阻塞原因引用的规则不是所属资格评估实际使用的规则。" ;
        sh:select """
            PREFIX mnp: <http://example.org/kg-mnp#>
            SELECT $this ?rule
            WHERE {
              $this mnp:triggeredByRule ?rule .
              FILTER NOT EXISTS {
                ?assessment mnp:producesBlockingReason $this ;
                            mnp:evaluatedByRule ?rule .
              }
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "阻塞原因引用的规则版本不是所属资格评估实际使用的规则版本。" ;
        sh:select """
            PREFIX mnp: <http://example.org/kg-mnp#>
            SELECT $this ?rv
            WHERE {
              $this mnp:triggeredByRuleVersion ?rv .
              FILTER NOT EXISTS {
                ?assessment mnp:producesBlockingReason $this ;
                            mnp:usesRuleVersion ?rv .
              }
            }
        """ ;
    ] ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "阻塞原因引用的监管条款与其触发规则所执行的条款不一致。" ;
        sh:select """
            PREFIX mnp: <http://example.org/kg-mnp#>
            SELECT $this ?clause
            WHERE {
              $this mnp:triggeredByRule ?rule ;
                    mnp:citesClause ?clause .
              FILTER NOT EXISTS {
                ?rule mnp:operationalizesClause ?clause .
              }
            }
        """ ;
    ] .

mnp:EligibilityRuleShape a sh:NodeShape ;
    sh:targetClass mnp:EligibilityRule ;
    sh:property [
        sh:path mnp:ruleIdentifier ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "资格规则必须有规则编号 (ruleIdentifier)。" ;
    ] ;
    sh:property [
        sh:path mnp:ruleVersion ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "资格规则必须有规则版本 (ruleVersion)。" ;
    ] ;
    sh:property [
        sh:path mnp:effectiveFrom ;
        sh:datatype xsd:dateTime ;
        sh:minCount 1 ;
        sh:message "资格规则必须有生效时间 (effectiveFrom)。" ;
    ] ;
    sh:property [
        sh:path mnp:operationalizesClause ;
        sh:class mnp:RegulatoryClause ;
        sh:minCount 1 ;
        sh:message "资格规则必须至少关联一条监管条款 (operationalizesClause)。" ;
    ] .

mnp:ServiceContractShape a sh:NodeShape ;
    sh:targetClass mnp:ServiceContract ;
    sh:sparql [
        a sh:SPARQLConstraint ;
        sh:message "状态为 ACTIVE 的有效合约必须提供截止时间 (contractEndTime)。" ;
        sh:select """
            PREFIX mnp: <http://example.org/kg-mnp#>
            SELECT $this WHERE {
                $this mnp:contractStatusCode ?status .
                FILTER(STR(?status) = "ACTIVE")
                FILTER NOT EXISTS { $this mnp:contractEndTime ?end }
            }
        """ ;
    ] .

mnp:MappingRecordShape a sh:NodeShape ;
    sh:targetClass mnp:MappingRecord ;
    sh:property [
        sh:path mnp:sourceApi ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "映射记录必须包含源 API (sourceApi)。" ;
    ] ;
    sh:property [
        sh:path mnp:sourceFieldPath ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "映射记录必须包含源字段路径 (sourceFieldPath)。" ;
    ] ;
    sh:property [
        sh:path mnp:targetTerm ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "映射记录必须包含目标术语 (targetTerm)。" ;
    ] ;
    sh:property [
        sh:path mnp:mappingReviewStatus ;
        sh:datatype xsd:string ;
        sh:minCount 1 ;
        sh:message "映射记录必须包含审查状态 (mappingReviewStatus)。" ;
    ] .
