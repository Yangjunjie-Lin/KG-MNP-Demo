{
  "$defs": {
    "ArtifactRef": {
      "additionalProperties": false,
      "properties": {
        "artifact_id": {
          "title": "Artifact Id",
          "type": "string"
        },
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "project_id": {
          "title": "Project Id",
          "type": "string"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "stage_id": {
          "maximum": 5,
          "minimum": 0,
          "title": "Stage Id",
          "type": "integer"
        },
        "step_id": {
          "title": "Step Id",
          "type": "string"
        },
        "artifact_version": {
          "title": "Artifact Version",
          "type": "string"
        },
        "content_hash": {
          "pattern": "^[a-f0-9]{64}$",
          "title": "Content Hash",
          "type": "string"
        },
        "storage_ref": {
          "pattern": "^urn:kg-mnp:stage-artifact:[a-f0-9]{64}$",
          "title": "Storage Ref",
          "type": "string"
        },
        "media_type": {
          "const": "application/json",
          "default": "application/json",
          "title": "Media Type",
          "type": "string"
        },
        "data_kind": {
          "enum": [
            "KG_IR",
            "MODELING_CANDIDATE",
            "SEMANTIC_DELIVERY",
            "REPORT",
            "CONFIGURATION"
          ],
          "title": "Data Kind",
          "type": "string"
        },
        "record_count": {
          "minimum": 0,
          "title": "Record Count",
          "type": "integer"
        },
        "produced_by": {
          "title": "Produced By",
          "type": "string"
        },
        "hash_profile": {
          "const": "KG-MNP Canonical JSON v1",
          "default": "KG-MNP Canonical JSON v1",
          "title": "Hash Profile",
          "type": "string"
        }
      },
      "required": [
        "artifact_id",
        "project_id",
        "session_id",
        "stage_id",
        "step_id",
        "artifact_version",
        "content_hash",
        "storage_ref",
        "data_kind",
        "record_count",
        "produced_by"
      ],
      "title": "ArtifactRef",
      "type": "object"
    },
    "StageRun": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "bundle_id": {
          "title": "Bundle Id",
          "type": "string"
        },
        "stage_id": {
          "maximum": 5,
          "minimum": 0,
          "title": "Stage Id",
          "type": "integer"
        },
        "session_id": {
          "title": "Session Id",
          "type": "string"
        },
        "parent_bundle_refs": {
          "items": {
            "type": "string"
          },
          "title": "Parent Bundle Refs",
          "type": "array"
        },
        "inherited_artifact_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Inherited Artifact Refs",
          "type": "array"
        },
        "new_artifact_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "New Artifact Refs",
          "type": "array"
        },
        "status": {
          "default": "NOT_RUN",
          "enum": [
            "NOT_RUN",
            "READY",
            "RUNNING",
            "BLOCKED",
            "SUCCEEDED",
            "FAILED",
            "CANCELLED",
            "STALE"
          ],
          "title": "Status",
          "type": "string"
        },
        "authority": {
          "const": "OBSERVATION_ONLY",
          "default": "OBSERVATION_ONLY",
          "title": "Authority",
          "type": "string"
        }
      },
      "required": [
        "bundle_id",
        "stage_id",
        "session_id",
        "parent_bundle_refs",
        "inherited_artifact_refs",
        "new_artifact_refs"
      ],
      "title": "StageRun",
      "type": "object"
    },
    "StepRun": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "1.0.0",
          "default": "1.0.0",
          "title": "Schema Version",
          "type": "string"
        },
        "step_id": {
          "pattern": "^[1-5]\\.[1-6]$",
          "title": "Step Id",
          "type": "string"
        },
        "run_id": {
          "title": "Run Id",
          "type": "string"
        },
        "input_artifact_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Input Artifact Refs",
          "type": "array"
        },
        "output_artifact_refs": {
          "items": {
            "$ref": "#/$defs/ArtifactRef"
          },
          "title": "Output Artifact Refs",
          "type": "array"
        },
        "execution_kind": {
          "enum": [
            "LIVE",
            "DETERMINISTIC",
            "RECORDED_MODEL_OUTPUT",
            "TUTORIAL_FIXTURE"
          ],
          "title": "Execution Kind",
          "type": "string"
        },
        "job_id": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Job Id"
        },
        "configuration_hash": {
          "title": "Configuration Hash",
          "type": "string"
        },
        "tool_versions": {
          "additionalProperties": {
            "type": "string"
          },
          "title": "Tool Versions",
          "type": "object"
        },
        "model_revision": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Model Revision"
        },
        "status": {
          "enum": [
            "NOT_RUN",
            "READY",
            "RUNNING",
            "BLOCKED",
            "SUCCEEDED",
            "FAILED",
            "CANCELLED",
            "STALE"
          ],
          "title": "Status",
          "type": "string"
        },
        "validation_status": {
          "default": "NOT_RUN",
          "enum": [
            "PASS",
            "FAIL",
            "NOT_RUN",
            "NOT_APPLICABLE",
            "ERROR",
            "TIMEOUT"
          ],
          "title": "Validation Status",
          "type": "string"
        },
        "review_status": {
          "default": "PENDING",
          "enum": [
            "PENDING",
            "APPROVED",
            "REJECTED",
            "CHANGES_REQUESTED"
          ],
          "title": "Review Status",
          "type": "string"
        },
        "validation_refs": {
          "items": {
            "type": "string"
          },
          "title": "Validation Refs",
          "type": "array"
        },
        "review_refs": {
          "items": {
            "type": "string"
          },
          "title": "Review Refs",
          "type": "array"
        },
        "created_at": {
          "title": "Created At",
          "type": "string"
        },
        "scope": {
          "title": "Scope",
          "type": "string"
        }
      },
      "required": [
        "step_id",
        "run_id",
        "input_artifact_refs",
        "output_artifact_refs",
        "execution_kind",
        "configuration_hash",
        "tool_versions",
        "status",
        "created_at",
        "scope"
      ],
      "title": "StepRun",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0",
      "default": "1.0.0",
      "title": "Schema Version",
      "type": "string"
    },
    "session_id": {
      "title": "Session Id",
      "type": "string"
    },
    "project_id": {
      "title": "Project Id",
      "type": "string"
    },
    "source_run_id": {
      "title": "Source Run Id",
      "type": "string"
    },
    "stages": {
      "items": {
        "$ref": "#/$defs/StageRun"
      },
      "title": "Stages",
      "type": "array"
    },
    "step_runs": {
      "items": {
        "$ref": "#/$defs/StepRun"
      },
      "title": "Step Runs",
      "type": "array"
    },
    "delivery_status": {
      "default": "NOT_DELIVERED",
      "enum": [
        "NOT_DELIVERED",
        "VALIDATED_UNPUBLISHED"
      ],
      "title": "Delivery Status",
      "type": "string"
    }
  },
  "required": [
    "session_id",
    "project_id",
    "source_run_id",
    "stages",
    "step_runs"
  ],
  "title": "ModelingSession",
  "type": "object"
}
