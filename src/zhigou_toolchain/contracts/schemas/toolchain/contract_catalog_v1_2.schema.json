{
  "$id": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/toolchain/contract-catalog/1.2",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "description": "Compatible additive catalog revision adding the compilation scope.",
  "properties": {
    "canonicalization_profile": {
      "const": "KG-MNP Canonical JSON v1"
    },
    "contracts": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "authority_level": {
            "enum": [
              "descriptive",
              "proposal",
              "confirmed-input",
              "control",
              "lock"
            ]
          },
          "name": {
            "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/toolchain/toolchain-common/1.0#/$defs/contractName"
          },
          "resource_path": {
            "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/toolchain/toolchain-common/1.0#/$defs/safeRelativePosixPath"
          },
          "schema_id": {
            "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/toolchain/toolchain-common/1.0#/$defs/iri"
          },
          "scope": {
            "enum": [
              "toolchain",
              "modeling",
              "ingestion",
              "compilation"
            ]
          },
          "sha256": {
            "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/toolchain/toolchain-common/1.0#/$defs/sha256"
          },
          "stability": {
            "enum": [
              "stable",
              "retained",
              "experimental"
            ]
          },
          "version": {
            "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/toolchain/toolchain-common/1.0#/$defs/semanticVersion"
          }
        },
        "required": [
          "name",
          "version",
          "schema_id",
          "resource_path",
          "scope",
          "stability",
          "authority_level",
          "sha256"
        ],
        "type": "object"
      },
      "maxItems": 100000,
      "minItems": 1,
      "type": "array"
    },
    "manifest_kind": {
      "const": "KG_MNP_CONTRACT_CATALOG"
    },
    "schema_version": {
      "const": "1.2.0"
    }
  },
  "required": [
    "manifest_kind",
    "schema_version",
    "canonicalization_profile",
    "contracts"
  ],
  "title": "KG-MNP Public Contract Catalog 1.2",
  "type": "object"
}
