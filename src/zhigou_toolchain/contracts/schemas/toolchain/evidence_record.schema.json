{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/toolchain/evidence-record/1.0",
  "title": "KG-MNP EvidenceRecord v1",
  "type": "object", "additionalProperties": false,
  "required": ["manifest_kind", "schema_version", "evidence_id", "source_id", "source_content_sha256", "locator", "observed_content_sha256", "observed_content_media_type", "observed_value", "plugin_snapshot_id", "transformation_ids", "quality_flags", "content_digest"],
  "properties": {
    "manifest_kind": {"const": "KG_MNP_EVIDENCE_RECORD"}, "schema_version": {"const": "1.0.0"},
    "evidence_id": {"$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/toolchain/toolchain-common/1.0#/$defs/stableUrn"},
    "source_id": {"$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/toolchain/toolchain-common/1.0#/$defs/stableUrn"},
    "source_content_sha256": {"$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/toolchain/toolchain-common/1.0#/$defs/sha256"},
    "locator": {"$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/toolchain/source-locator/1.0"},
    "observed_content_sha256": {"$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/toolchain/toolchain-common/1.0#/$defs/sha256"},
    "observed_content_media_type": {"$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/toolchain/toolchain-common/1.0#/$defs/mediaType"},
    "observed_value": {"oneOf": [{"type": ["string", "integer", "boolean", "null"]}, {"type": "object", "additionalProperties": false, "required": ["decimal"], "properties": {"decimal": {"type": "string", "pattern": "^-?(?:0|[1-9][0-9]*)(?:\\.[0-9]+)?(?:[eE][+-]?[0-9]+)?$"}}}]},
    "plugin_snapshot_id": {"$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/toolchain/toolchain-common/1.0#/$defs/stableUrn"},
    "transformation_ids": {"type": "array", "uniqueItems": true, "items": {"$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/toolchain/toolchain-common/1.0#/$defs/stableUrn"}},
    "quality_flags": {"type": "array", "uniqueItems": true, "items": {"type": "string", "pattern": "^[A-Z][A-Z0-9_]*$"}},
    "content_digest": {"$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/toolchain/toolchain-common/1.0#/$defs/sha256"}
  }
}
