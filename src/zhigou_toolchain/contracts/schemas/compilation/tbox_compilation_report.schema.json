{
  "$id": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/tbox-compilation-report/1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content_digest": {
      "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-common/1.0#/$defs/sha256"
    },
    "issues": {
      "items": {
        "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-common/1.0#/$defs/issue"
      },
      "maxItems": 10000,
      "minItems": 0,
      "type": "array"
    },
    "items": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "candidate_type": {
            "maxLength": 64,
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "type": "string"
          },
          "confirmed_item_id": {
            "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-common/1.0#/$defs/stableId"
          },
          "output_ids": {
            "items": {
              "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-common/1.0#/$defs/iri"
            },
            "maxItems": 100000,
            "minItems": 0,
            "type": "array",
            "uniqueItems": true
          },
          "statement_count": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "confirmed_item_id",
          "candidate_type",
          "output_ids",
          "statement_count"
        ],
        "type": "object"
      },
      "maxItems": 100000,
      "minItems": 0,
      "type": "array"
    },
    "manifest_kind": {
      "const": "KG_MNP_TBOX_COMPILATION_REPORT"
    },
    "output_files": {
      "items": {
        "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-common/1.0#/$defs/safePath"
      },
      "maxItems": 10000,
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "partition": {
      "const": "TBOX"
    },
    "plan_id": {
      "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-common/1.0#/$defs/stableId"
    },
    "report_id": {
      "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-common/1.0#/$defs/stableId"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "semantic_sha256": {
      "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-common/1.0#/$defs/sha256"
    },
    "statement_count": {
      "minimum": 0,
      "type": "integer"
    },
    "status": {
      "enum": [
        "PASSED",
        "FAILED"
      ]
    }
  },
  "required": [
    "manifest_kind",
    "schema_version",
    "report_id",
    "plan_id",
    "partition",
    "items",
    "statement_count",
    "semantic_sha256",
    "output_files",
    "status",
    "issues",
    "content_digest"
  ],
  "title": "KG-MNP TBox Compilation Report 1.0",
  "type": "object"
}
