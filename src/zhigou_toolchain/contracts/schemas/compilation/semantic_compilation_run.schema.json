{
  "$id": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/semantic-compilation-run/1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "build_id": {
      "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-common/1.0#/$defs/stableId"
    },
    "content_digest": {
      "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-common/1.0#/$defs/sha256"
    },
    "issues": {
      "items": {
        "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-common/1.0#/$defs/issue"
      },
      "maxItems": 10000,
      "minItems": 0,
      "type": "array"
    },
    "manifest_kind": {
      "const": "KG_MNP_SEMANTIC_COMPILATION_RUN"
    },
    "operation_statuses": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "operation": {
            "maxLength": 64,
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "type": "string"
          },
          "status": {
            "enum": [
              "PASSED",
              "FAILED",
              "NOT_RUN"
            ]
          }
        },
        "required": [
          "operation",
          "status"
        ],
        "type": "object"
      },
      "maxItems": 32,
      "minItems": 0,
      "type": "array"
    },
    "package_id": {
      "oneOf": [
        {
          "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-common/1.0#/$defs/stableId"
        },
        {
          "type": "null"
        }
      ]
    },
    "plan_id": {
      "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-common/1.0#/$defs/stableId"
    },
    "run_id": {
      "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-common/1.0#/$defs/stableId"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "status": {
      "enum": [
        "SUCCEEDED",
        "FAILED"
      ]
    }
  },
  "required": [
    "manifest_kind",
    "schema_version",
    "run_id",
    "plan_id",
    "build_id",
    "package_id",
    "operation_statuses",
    "status",
    "issues",
    "content_digest"
  ],
  "title": "KG-MNP Semantic Compilation Run 1.0",
  "type": "object"
}
