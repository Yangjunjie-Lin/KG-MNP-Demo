{
  "$id": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/provenance-closure-report/1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "closed_statement_count": {
      "minimum": 0,
      "type": "integer"
    },
    "content_digest": {
      "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-common/1.0#/$defs/sha256"
    },
    "coverage_basis_points": {
      "maximum": 10000,
      "minimum": 0,
      "type": "integer"
    },
    "manifest_kind": {
      "const": "KG_MNP_PROVENANCE_CLOSURE_REPORT"
    },
    "missing_links": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "missing_ref": {
            "maxLength": 256,
            "minLength": 1,
            "type": "string"
          },
          "relation": {
            "maxLength": 64,
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "type": "string"
          },
          "statement_id": {
            "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-common/1.0#/$defs/stableId"
          }
        },
        "required": [
          "statement_id",
          "relation",
          "missing_ref"
        ],
        "type": "object"
      },
      "maxItems": 100000,
      "minItems": 0,
      "type": "array"
    },
    "orphan_records": {
      "items": {
        "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-common/1.0#/$defs/stableId"
      },
      "maxItems": 100000,
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "report_id": {
      "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-common/1.0#/$defs/stableId"
    },
    "required_statement_count": {
      "minimum": 0,
      "type": "integer"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "status": {
      "enum": [
        "PASSED",
        "FAILED"
      ]
    }
  },
  "required": [
    "manifest_kind",
    "schema_version",
    "report_id",
    "required_statement_count",
    "closed_statement_count",
    "coverage_basis_points",
    "missing_links",
    "orphan_records",
    "status",
    "content_digest"
  ],
  "title": "KG-MNP Provenance Closure Report 1.0",
  "type": "object"
}
