{
  "$id": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/rdf-dataset-manifest/1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "content_digest": {
      "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-common/1.0#/$defs/sha256"
    },
    "dataset_id": {
      "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-common/1.0#/$defs/stableId"
    },
    "dataset_semantic_digest": {
      "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-common/1.0#/$defs/sha256"
    },
    "graphs": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "graph_iri": {
            "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-common/1.0#/$defs/iri"
          },
          "graph_semantic_digest": {
            "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-common/1.0#/$defs/sha256"
          },
          "provenance_coverage_basis_points": {
            "maximum": 10000,
            "minimum": 0,
            "type": "integer"
          },
          "role": {
            "maxLength": 64,
            "pattern": "^[a-z]+(?:-[a-z]+)*$",
            "type": "string"
          },
          "source_confirmed_item_count": {
            "minimum": 0,
            "type": "integer"
          },
          "triple_count": {
            "minimum": 0,
            "type": "integer"
          }
        },
        "required": [
          "role",
          "graph_iri",
          "triple_count",
          "graph_semantic_digest",
          "source_confirmed_item_count",
          "provenance_coverage_basis_points"
        ],
        "type": "object"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array"
    },
    "manifest_kind": {
      "const": "KG_MNP_RDF_DATASET_MANIFEST"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "total_quad_count": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "manifest_kind",
    "schema_version",
    "dataset_id",
    "graphs",
    "total_quad_count",
    "dataset_semantic_digest",
    "content_digest"
  ],
  "title": "KG-MNP RDF Dataset Manifest 1.0",
  "type": "object"
}
