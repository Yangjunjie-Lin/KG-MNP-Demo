        "PackageImported",
        "FeedbackRecorded",
        "ChangeProposalCreated",
        "ChangeProposalSubmitted",
        "CandidatePackageAttached",
        "ChangeEvaluated",
        "ConsumerRegistered",
        "ConsumerSuperseded",
        "ReleaseCandidateCreated",
        "ReleaseCandidateSubmitted",
        "ReleaseReviewInitialized",
        "ReleaseReviewRecorded",
        "ReleaseReviewFinalized",
        "ReleasePublished",
        "EnvironmentCreated",
        "ActivationProposed",
        "ActivationReviewed",
        "ActivationApplied",
        "RollbackProposed",
        "RollbackReviewed",
        "RollbackApplied"
