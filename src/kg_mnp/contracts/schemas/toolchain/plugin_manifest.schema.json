{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/toolchain/plugin-manifest/1.0",
  "title": "KG-MNP PluginManifest v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_kind", "schema_version", "plugin_api_version", "plugin_id", "plugin_version", "display_name", "description", "distribution", "entry_point", "plugin_kinds", "capabilities", "media_types", "priority", "determinism", "side_effects", "implementation_files", "configuration_contract", "requirements", "extensions"],
  "properties": {
    "manifest_kind": {"const": "KG_MNP_PLUGIN"},
    "schema_version": {"const": "1.0.0"},
    "plugin_api_version": {"$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/toolchain/plugin-common/1.0#/$defs/pluginApiVersion"},
    "plugin_id": {"$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/toolchain/plugin-common/1.0#/$defs/pluginId"},
    "plugin_version": {"$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/toolchain/toolchain-common/1.0#/$defs/semanticVersion"},
    "display_name": {"type": "string", "minLength": 1, "maxLength": 160},
    "description": {"type": "string", "minLength": 1, "maxLength": 2000},
    "distribution": {
      "type": "object", "additionalProperties": false,
      "required": ["name", "required_version"],
      "properties": {
        "name": {"$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/toolchain/plugin-common/1.0#/$defs/distributionName"},
        "required_version": {"$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/toolchain/toolchain-common/1.0#/$defs/semanticVersion"}
      }
    },
    "entry_point": {
      "type": "object", "additionalProperties": false,
      "required": ["group", "name", "object"],
      "properties": {
        "group": {"const": "kg_mnp.plugins"},
        "name": {"$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/toolchain/plugin-common/1.0#/$defs/entryPointName"},
        "object": {"type": "string", "pattern": "^[A-Za-z_][A-Za-z0-9_.]*:[A-Za-z_][A-Za-z0-9_.]*$"}
      }
    },
    "plugin_kinds": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/toolchain/plugin-common/1.0#/$defs/pluginKind"}},
    "capabilities": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/toolchain/plugin-common/1.0#/$defs/capabilityId"}},
    "media_types": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/toolchain/plugin-common/1.0#/$defs/mediaTypePattern"}},
    "priority": {"type": "integer", "minimum": -1000, "maximum": 1000},
    "determinism": {"$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/toolchain/plugin-common/1.0#/$defs/deterministicMode"},
    "side_effects": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/toolchain/plugin-common/1.0#/$defs/sideEffectClass"}},
    "implementation_files": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/toolchain/plugin-common/1.0#/$defs/implementationFile"}},
    "configuration_contract": {
      "oneOf": [
        {"type": "null"},
        {"type": "object", "additionalProperties": false, "required": ["resource", "schema_id", "sha256"], "properties": {
          "resource": {"$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/toolchain/toolchain-common/1.0#/$defs/safeRelativePosixPath"},
          "schema_id": {"$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/toolchain/toolchain-common/1.0#/$defs/iri"},
          "sha256": {"$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/toolchain/toolchain-common/1.0#/$defs/sha256"}
        }}
      ]
    },
    "requirements": {
      "type": "object", "additionalProperties": false,
      "required": ["python", "toolchain_minimum", "optional_dependencies"],
      "properties": {
        "python": {"type": "string", "pattern": "^>=3\\.11(?:,<4)?$"},
        "toolchain_minimum": {"$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/toolchain/toolchain-common/1.0#/$defs/semanticVersion"},
        "optional_dependencies": {"type": "array", "uniqueItems": true, "items": {"$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/toolchain/plugin-common/1.0#/$defs/distributionName"}}
      }
    },
    "extensions": {"$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/toolchain/toolchain-common/1.0#/$defs/extensionMap"}
  }
}
