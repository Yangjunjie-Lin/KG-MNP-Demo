        {
          "type": "null"
        }
      ]
    },
    "version_relation": {
      "enum": [
        "UNCHANGED",
        "PATCH",
        "MINOR",
        "MAJOR"
      ]
    }
  },
  "required": [
    "manifest_kind",
    "schema_version",
    "report_id",
    "content_digest",
    "registry_id",
    "semantic_diff_id",
    "base_version",
    "candidate_version",
    "version_relation",
    "semantic_classification",
    "required_version_change",
    "actual_version_change",
    "pre_one_policy",
    "compatible",
    "issues"
