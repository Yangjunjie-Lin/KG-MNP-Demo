{
  "$id": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/lifecycle/impact-analysis-report/1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "affected_competency_questions": {
      "type": [
        "string",
        "number",
        "boolean",
        "object",
        "array",
        "null"
      ]
    },
    "affected_consumers": {
      "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/lifecycle/lifecycle-common/1.0#/$defs/ids"
    },
    "affected_environments": {
      "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/lifecycle/lifecycle-common/1.0#/$defs/ids"
    },
    "affected_mappings": {
      "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/lifecycle/lifecycle-common/1.0#/$defs/ids"
    },
    "affected_packages": {
      "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/lifecycle/lifecycle-common/1.0#/$defs/ids"
    },
    "affected_releases": {
      "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/lifecycle/lifecycle-common/1.0#/$defs/ids"
    },
    "affected_terms": {
      "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/lifecycle/lifecycle-common/1.0#/$defs/iris"
    },
    "completeness_scope": {
      "type": [
        "string",
        "number",
        "boolean",
        "object",
        "array",
        "null"
      ]
    },
    "content_digest": {
      "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/lifecycle/lifecycle-common/1.0#/$defs/sha"
    },
    "dependency_graph_snapshot_id": {
      "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/lifecycle/lifecycle-common/1.0#/$defs/id"
    },
    "impact_id": {
      "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/lifecycle/lifecycle-common/1.0#/$defs/id"
    },
    "manifest_kind": {
      "const": "KG_MNP_IMPACT_ANALYSIS_REPORT"
    },
    "migration_requirements": {
      "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/lifecycle/lifecycle-common/1.0#/$defs/migrations"
    },
    "registry_id": {
      "oneOf": [
        {
          "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/lifecycle/lifecycle-common/1.0#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "regression_requirements": {
      "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/lifecycle/lifecycle-common/1.0#/$defs/labels"
    },
    "risk_summary": {
      "additionalProperties": false,
      "properties": {
        "overall": {
          "enum": [
            "LOW",
            "MEDIUM",
            "HIGH",
            "CRITICAL",
            "UNKNOWN"
          ]
        },
        "reasons": {
          "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/lifecycle/lifecycle-common/1.0#/$defs/texts"
        }
      },
      "required": [
        "overall",
        "reasons"
      ],
      "type": "object"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "semantic_diff_id": {
      "oneOf": [
        {
          "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/lifecycle/lifecycle-common/1.0#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "status": {
      "enum": [
        "COMPLETE",
        "INCOMPLETE",
        "BLOCKED"
      ]
    },
    "unknown_impacts": {
      "type": [
        "string",
        "number",
        "boolean",
        "object",
        "array",
        "null"
      ]
    }
  },
  "required": [
    "manifest_kind",
    "schema_version",
    "impact_id",
    "content_digest",
    "registry_id",
    "semantic_diff_id",
    "dependency_graph_snapshot_id",
    "affected_packages",
    "affected_releases",
    "affected_consumers",
    "affected_environments",
    "affected_terms",
    "affected_mappings",
    "affected_competency_questions",
    "migration_requirements",
    "regression_requirements",
    "unknown_impacts",
    "risk_summary",
    "completeness_scope",
    "status"
  ],
  "title": "KG-MNP Impact Analysis Report 1.0",
  "type": "object",
  "x-authority-level": "descriptive",
  "x-identity-field": "impact_id"
}
