{
  "$id": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/lifecycle/release-review-decision-log/1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "actions": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "maxItems": 10000,
      "minItems": 0,
      "type": "array",
      "uniqueItems": true
    },
    "authority_digests": {
      "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/lifecycle/lifecycle-common/1.0#/$defs/authorityDigests"
    },
    "content_digest": {
      "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/lifecycle/lifecycle-common/1.0#/$defs/sha"
    },
    "final_decision": {
      "enum": [
        "APPROVE",
        "REJECT",
        "REQUEST_CHANGES",
        "ABSTAIN",
        "INIT"
      ]
    },
    "finalized": {
      "type": "boolean"
    },
    "manifest_kind": {
      "const": "KG_MNP_RELEASE_REVIEW_DECISION_LOG"
    },
    "quorum_satisfied": {
      "type": "boolean"
    },
    "registry_id": {
      "oneOf": [
        {
          "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/lifecycle/lifecycle-common/1.0#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "release_candidate_id": {
      "oneOf": [
        {
          "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/lifecycle/lifecycle-common/1.0#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "release_policy_id": {
      "oneOf": [
        {
          "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/lifecycle/lifecycle-common/1.0#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "review_id": {
      "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/lifecycle/lifecycle-common/1.0#/$defs/id"
    },
    "review_log_id": {
      "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/lifecycle/lifecycle-common/1.0#/$defs/id"
    },
    "review_policy_id": {
      "oneOf": [
        {
          "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/lifecycle/lifecycle-common/1.0#/$defs/id"
        },
        {
          "type": "null"
        }
      ]
    },
    "role_coverage": {
      "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/lifecycle/lifecycle-common/1.0#/$defs/labels"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "semantic_decision_hash": {
      "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/lifecycle/lifecycle-common/1.0#/$defs/sha"
    }
  },
  "required": [
    "manifest_kind",
    "schema_version",
    "review_log_id",
    "content_digest",
    "registry_id",
    "review_id",
    "release_candidate_id",
    "release_policy_id",
    "review_policy_id",
    "actions",
    "semantic_decision_hash",
    "final_decision",
    "role_coverage",
    "quorum_satisfied",
    "finalized",
    "authority_digests"
  ],
  "title": "KG-MNP Release Review Decision Log 1.0",
  "type": "object",
  "x-authority-level": "control",
  "x-identity-field": "review_log_id"
}
