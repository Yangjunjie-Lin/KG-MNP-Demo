{
  "$id": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/ontology-package-validation-report/1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "checks": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "check": {
            "maxLength": 128,
            "pattern": "^[A-Z][A-Z0-9_]*$",
            "type": "string"
          },
          "report_ref": {
            "oneOf": [
              {
                "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-common/1.0#/$defs/stableId"
              },
              {
                "type": "null"
              }
            ]
          },
          "status": {
            "enum": [
              "PASSED",
              "FAILED",
              "NOT_RUN"
            ]
          }
        },
        "required": [
          "check",
          "status",
          "report_ref"
        ],
        "type": "object"
      },
      "maxItems": 64,
      "minItems": 1,
      "type": "array"
    },
    "content_digest": {
      "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-common/1.0#/$defs/sha256"
    },
    "issues": {
      "items": {
        "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-common/1.0#/$defs/issue"
      },
      "maxItems": 10000,
      "minItems": 0,
      "type": "array"
    },
    "manifest_kind": {
      "const": "KG_MNP_ONTOLOGY_PACKAGE_VALIDATION_REPORT"
    },
    "package_id": {
      "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-common/1.0#/$defs/stableId"
    },
    "report_id": {
      "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-common/1.0#/$defs/stableId"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "status": {
      "enum": [
        "VALID",
        "INVALID"
      ]
    }
  },
  "required": [
    "manifest_kind",
    "schema_version",
    "report_id",
    "package_id",
    "checks",
    "status",
    "issues",
    "content_digest"
  ],
  "title": "KG-MNP Ontology Package Validation Report 1.0",
  "type": "object"
}
