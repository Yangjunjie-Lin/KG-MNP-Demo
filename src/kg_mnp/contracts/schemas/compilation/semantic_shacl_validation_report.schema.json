{
  "$id": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/semantic-shacl-validation-report/1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "conforms": {
      "type": "boolean"
    },
    "content_digest": {
      "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-common/1.0#/$defs/sha256"
    },
    "data_graph_digest": {
      "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-common/1.0#/$defs/sha256"
    },
    "execution_limits": {
      "items": {
        "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-common/1.0#/$defs/resourceLimit"
      },
      "maxItems": 32,
      "minItems": 1,
      "type": "array"
    },
    "inference_profile": {
      "enum": [
        "NONE",
        "RDFS",
        "OWL_RL"
      ]
    },
    "info_count": {
      "minimum": 0,
      "type": "integer"
    },
    "manifest_kind": {
      "const": "KG_MNP_SEMANTIC_SHACL_VALIDATION_REPORT"
    },
    "meta_shacl_status": {
      "enum": [
        "PASSED",
        "FAILED",
        "NOT_RUN_UNSUPPORTED"
      ]
    },
    "ontology_graph_digest": {
      "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-common/1.0#/$defs/sha256"
    },
    "pyshacl_version": {
      "maxLength": 64,
      "minLength": 1,
      "type": "string"
    },
    "report_id": {
      "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-common/1.0#/$defs/stableId"
    },
    "results": {
      "items": {
        "additionalProperties": false,
        "properties": {
          "focus_node": {
            "oneOf": [
              {
                "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-common/1.0#/$defs/iri"
              },
              {
                "type": "null"
              }
            ]
          },
          "message": {
            "maxLength": 4096,
            "type": "string"
          },
          "result_id": {
            "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-common/1.0#/$defs/stableId"
          },
          "severity": {
            "enum": [
              "VIOLATION",
              "WARNING",
              "INFO"
            ]
          },
          "source_shape": {
            "oneOf": [
              {
                "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-common/1.0#/$defs/iri"
              },
              {
                "type": "null"
              }
            ]
          }
        },
        "required": [
          "result_id",
          "severity",
          "focus_node",
          "source_shape",
          "message"
        ],
        "type": "object"
      },
      "maxItems": 100000,
      "minItems": 0,
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0"
    },
    "shape_graph_digest": {
      "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-common/1.0#/$defs/sha256"
    },
    "status": {
      "enum": [
        "CONFORMS",
        "VIOLATION",
        "ENGINE_ERROR",
        "TIMEOUT"
      ]
    },
    "violation_count": {
      "minimum": 0,
      "type": "integer"
    },
    "warning_count": {
      "minimum": 0,
      "type": "integer"
    }
  },
  "required": [
    "manifest_kind",
    "schema_version",
    "report_id",
    "conforms",
    "status",
    "results",
    "violation_count",
    "warning_count",
    "info_count",
    "shape_graph_digest",
    "data_graph_digest",
    "ontology_graph_digest",
    "pyshacl_version",
    "inference_profile",
    "meta_shacl_status",
    "execution_limits",
    "content_digest"
  ],
  "title": "KG-MNP Semantic SHACL Validation Report 1.0",
  "type": "object"
}
