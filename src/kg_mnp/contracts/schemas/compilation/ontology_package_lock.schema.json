{
  "$id": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/ontology-package-lock/1.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "additionalProperties": false,
  "properties": {
    "canonicalization_profile": {
      "const": "KG-MNP RDF Canonical Profile v1"
    },
    "content_digest": {
      "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-common/1.0#/$defs/sha256"
    },
    "lock_id": {
      "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-common/1.0#/$defs/stableId"
    },
    "manifest_file_sha256": {
      "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-common/1.0#/$defs/sha256"
    },
    "manifest_kind": {
      "const": "KG_MNP_ONTOLOGY_PACKAGE_LOCK"
    },
    "manifest_semantic_sha256": {
      "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-common/1.0#/$defs/sha256"
    },
    "package_id": {
      "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-common/1.0#/$defs/stableId"
    },
    "package_name": {
      "maxLength": 128,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$",
      "type": "string"
    },
    "package_version": {
      "maxLength": 64,
      "pattern": "^(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)\\.(?:0|[1-9][0-9]*)$",
      "type": "string"
    },
    "payload_files": {
      "items": {
        "$ref": "https://yangjunjie-lin.github.io/KG-MNP-Demo/schemas/compilation/compilation-common/1.0#/$defs/fileRecord"
      },
      "maxItems": 10000,
      "minItems": 1,
      "type": "array"
    },
    "schema_version": {
      "const": "1.0.0"
    }
  },
  "required": [
    "manifest_kind",
    "schema_version",
    "lock_id",
    "package_id",
    "package_name",
    "package_version",
    "manifest_file_sha256",
    "manifest_semantic_sha256",
    "payload_files",
    "canonicalization_profile",
    "content_digest"
  ],
  "title": "KG-MNP Ontology Package Lock 1.0",
  "type": "object"
}
