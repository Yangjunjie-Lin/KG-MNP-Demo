<?xml version="1.0"?>
<rdf:RDF xmlns="http://example.org/kg-mnp/alignments#"
     xml:base="http://example.org/kg-mnp/alignments"
     xmlns:owl="http://www.w3.org/2002/07/owl#"
     xmlns:rdf="http://www.w3.org/1999/02/22-rdf-syntax-ns#"
     xmlns:xml="http://www.w3.org/XML/1998/namespace"
     xmlns:xsd="http://www.w3.org/2001/XMLSchema#"
     xmlns:rdfs="http://www.w3.org/2000/01/rdf-schema#"
     xmlns:skos="http://www.w3.org/2004/02/skos/core#"
     xmlns:terms="http://purl.org/dc/terms/"
     xmlns:kg-mnp="http://example.org/kg-mnp#">
    <owl:Ontology rdf:about="http://example.org/kg-mnp/alignments">
        <owl:imports rdf:resource="http://example.org/kg-mnp/core"/>
        <terms:description xml:lang="en">Domain ontology for Mobile Number Portability eligibility assessment with evidence-rule-clause-action traceability.</terms:description>
        <terms:title xml:lang="en">KG-MNP Alignments</terms:title>
        <terms:title xml:lang="en">KG-MNP Compliance Ontology</terms:title>
        <terms:title xml:lang="en">KG-MNP Core Ontology</terms:title>
        <rdfs:comment xml:lang="en">Compliance-oriented extensions for regulatory operationalization and reassessment.</rdfs:comment>
        <rdfs:comment xml:lang="en">Human-reviewed source and alignment annotations. Runtime loaders may skip this file.</rdfs:comment>
        <rdfs:comment xml:lang="en">OWL 2 concepts and stable cardinality constraints. Amount/date rules are executed in Python.</rdfs:comment>
        <owl:versionInfo>0.1.0</owl:versionInfo>
    </owl:Ontology>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Annotation properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://example.org/kg-mnp#alignmentStatus -->


    <owl:AnnotationProperty rdf:about="http://example.org/kg-mnp#alignmentStatus">
        <rdfs:comment xml:lang="en">VERIFIED, PARTIAL, or LOCAL_ONLY.</rdfs:comment>
        <rdfs:label xml:lang="en">Alignment Status</rdfs:label>
    </owl:AnnotationProperty>
    


    <!-- http://purl.org/dc/terms/description -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/description"/>
    


    <!-- http://purl.org/dc/terms/source -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/source"/>
    


    <!-- http://purl.org/dc/terms/title -->


    <owl:AnnotationProperty rdf:about="http://purl.org/dc/terms/title"/>
    


    <!-- http://www.w3.org/2004/02/skos/core#closeMatch -->


    <owl:AnnotationProperty rdf:about="http://www.w3.org/2004/02/skos/core#closeMatch"/>
    


    <!-- 
    ///////////////////////////////////////////////////////////////////////////////////////
    //
    // Object Properties
    //
    ///////////////////////////////////////////////////////////////////////////////////////
     -->


    


    <!-- http://example.org/kg-mnp#aboutCase -->


