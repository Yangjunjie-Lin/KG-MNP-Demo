    "@language" : "en",
    "@value" : "A catalogued telecom service or product offering/specification."
  }, {
    "@language" : "en",
    "@value" : "CTO Service (and CellularService subclass) describe telecom services. closeMatch only — CTO Service also covers broadband market catalogue semantics; MNP term is operational/catalog for portability."
  } ],
  "http://www.w3.org/2000/01/rdf-schema#label" : [ {
    "@language" : "en",
    "@value" : "Telecom Service"
  } ],
