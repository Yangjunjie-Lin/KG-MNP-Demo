@prefix : <http://example.org/kg-mnp/alignments#> .
@prefix owl: <http://www.w3.org/2002/07/owl#> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix xml: <http://www.w3.org/XML/1998/namespace> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@base <http://example.org/kg-mnp/alignments#> .

<http://example.org/kg-mnp/alignments> rdf:type owl:Ontology ;
                                        owl:imports <http://example.org/kg-mnp/core> ;
                                        <http://purl.org/dc/terms/description> "Domain ontology for Mobile Number Portability eligibility assessment with evidence-rule-clause-action traceability."@en ;
                                        <http://purl.org/dc/terms/title> "KG-MNP Alignments"@en ,
                                                                         "KG-MNP Compliance Ontology"@en ,
                                                                         "KG-MNP Core Ontology"@en ;
                                        rdfs:comment "Compliance-oriented extensions for regulatory operationalization and reassessment."@en ,
                                                     "Human-reviewed source and alignment annotations. Runtime loaders may skip this file."@en ,
                                                     "OWL 2 concepts and stable cardinality constraints. Amount/date rules are executed in Python."@en ;
                                        owl:versionInfo "0.1.0" .

#################################################################
#    Annotation properties
#################################################################

###  http://example.org/kg-mnp#alignmentStatus
<http://example.org/kg-mnp#alignmentStatus> rdf:type owl:AnnotationProperty ;
                                            rdfs:comment "VERIFIED, PARTIAL, or LOCAL_ONLY."@en ;
                                            rdfs:label "Alignment Status"@en .


###  http://purl.org/dc/terms/description
<http://purl.org/dc/terms/description> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/source
<http://purl.org/dc/terms/source> rdf:type owl:AnnotationProperty .


###  http://purl.org/dc/terms/title
<http://purl.org/dc/terms/title> rdf:type owl:AnnotationProperty .


###  http://www.w3.org/2004/02/skos/core#closeMatch
<http://www.w3.org/2004/02/skos/core#closeMatch> rdf:type owl:AnnotationProperty .


#################################################################
#    Object Properties
#################################################################

###  http://example.org/kg-mnp#aboutCase
<http://example.org/kg-mnp#aboutCase> rdf:type owl:ObjectProperty ;
                                      rdfs:domain <http://example.org/kg-mnp#EligibilityAssessment> ;
                                      rdfs:range <http://example.org/kg-mnp#MNPCase> .


###  http://example.org/kg-mnp#affectsAssessment
<http://example.org/kg-mnp#affectsAssessment> rdf:type owl:ObjectProperty ;
                                              rdfs:domain <http://example.org/kg-mnp#RuleVersion> ;
                                              rdfs:range <http://example.org/kg-mnp#EligibilityAssessment> .


###  http://example.org/kg-mnp#billedThrough
<http://example.org/kg-mnp#billedThrough> rdf:type owl:ObjectProperty ;
                                          rdfs:domain <http://example.org/kg-mnp#Subscriber> ;
                                          rdfs:range <http://example.org/kg-mnp#TelecomAccount> .


###  http://example.org/kg-mnp#citesClause
<http://example.org/kg-mnp#citesClause> rdf:type owl:ObjectProperty ;
                                        rdfs:domain <http://example.org/kg-mnp#BlockingReason> ;
                                        rdfs:range <http://example.org/kg-mnp#RegulatoryClause> .


###  http://example.org/kg-mnp#concernsNumber
<http://example.org/kg-mnp#concernsNumber> rdf:type owl:ObjectProperty ;
                                           rdfs:domain <http://example.org/kg-mnp#MNPCase> ;
                                           rdfs:range <http://example.org/kg-mnp#PhoneNumber> .


###  http://example.org/kg-mnp#dependsOn
<http://example.org/kg-mnp#dependsOn> rdf:type owl:ObjectProperty ;
                                      rdfs:domain <http://example.org/kg-mnp#EligibilityAssessment> ;
                                      rdfs:range <http://example.org/kg-mnp#AssessmentDependency> .


###  http://example.org/kg-mnp#dependsOnEvidence
<http://example.org/kg-mnp#dependsOnEvidence> rdf:type owl:ObjectProperty ;
                                              rdfs:domain <http://example.org/kg-mnp#AssessmentDependency> ;
                                              rdfs:range <http://example.org/kg-mnp#EvidenceRecord> .


###  http://example.org/kg-mnp#dependsOnRuleVersion
<http://example.org/kg-mnp#dependsOnRuleVersion> rdf:type owl:ObjectProperty ;
                                                 rdfs:domain <http://example.org/kg-mnp#AssessmentDependency> ;
                                                 rdfs:range <http://example.org/kg-mnp#RuleVersion> .


###  http://example.org/kg-mnp#evaluatedByRule
<http://example.org/kg-mnp#evaluatedByRule> rdf:type owl:ObjectProperty ;
                                            rdfs:domain <http://example.org/kg-mnp#EligibilityAssessment> ;
                                            rdfs:range <http://example.org/kg-mnp#EligibilityRule> .


###  http://example.org/kg-mnp#governedByContract
<http://example.org/kg-mnp#governedByContract> rdf:type owl:ObjectProperty ;
                                               rdfs:domain <http://example.org/kg-mnp#ServiceSubscription> ;
                                               rdfs:range <http://example.org/kg-mnp#ServiceContract> .


###  http://example.org/kg-mnp#hasEligibilityAssessment
<http://example.org/kg-mnp#hasEligibilityAssessment> rdf:type owl:ObjectProperty ;
                                                     rdfs:domain <http://example.org/kg-mnp#MNPCase> ;
                                                     rdfs:range <http://example.org/kg-mnp#EligibilityAssessment> .


###  http://example.org/kg-mnp#hasRuleVersion
<http://example.org/kg-mnp#hasRuleVersion> rdf:type owl:ObjectProperty ;
                                           rdfs:domain <http://example.org/kg-mnp#EligibilityRule> ;
                                           rdfs:range <http://example.org/kg-mnp#RuleVersion> .


###  http://example.org/kg-mnp#hasSourceSystem
<http://example.org/kg-mnp#hasSourceSystem> rdf:type owl:ObjectProperty ;
                                            rdfs:domain <http://example.org/kg-mnp#EvidenceRecord> ;
                                            rdfs:range <http://example.org/kg-mnp#InformationSystem> .


###  http://example.org/kg-mnp#hasSubscription
<http://example.org/kg-mnp#hasSubscription> rdf:type owl:ObjectProperty ;
                                            rdfs:domain <http://example.org/kg-mnp#Subscriber> ;
                                            rdfs:range <http://example.org/kg-mnp#ServiceSubscription> .


###  http://example.org/kg-mnp#markedForReassessment
<http://example.org/kg-mnp#markedForReassessment> rdf:type owl:ObjectProperty ;
                                                  rdfs:domain <http://example.org/kg-mnp#EligibilityAssessment> ;
                                                  rdfs:range <http://example.org/kg-mnp#ReassessmentMarker> .


###  http://example.org/kg-mnp#operationalizesClause
<http://example.org/kg-mnp#operationalizesClause> rdf:type owl:ObjectProperty ;
                                                  rdfs:domain <http://example.org/kg-mnp#EligibilityRule> ;
                                                  rdfs:range <http://example.org/kg-mnp#RegulatoryClause> .


###  http://example.org/kg-mnp#ownsPhoneNumber
<http://example.org/kg-mnp#ownsPhoneNumber> rdf:type owl:ObjectProperty ;
                                            rdfs:domain <http://example.org/kg-mnp#Subscriber> ;
                                            rdfs:range <http://example.org/kg-mnp#PhoneNumber> .


###  http://example.org/kg-mnp#partOfDocument
<http://example.org/kg-mnp#partOfDocument> rdf:type owl:ObjectProperty ;
                                           rdfs:domain <http://example.org/kg-mnp#RegulatoryClause> ;
                                           rdfs:range <http://example.org/kg-mnp#RegulatoryDocument> .


###  http://example.org/kg-mnp#producesBlockingReason
<http://example.org/kg-mnp#producesBlockingReason> rdf:type owl:ObjectProperty ;
                                                   rdfs:domain <http://example.org/kg-mnp#EligibilityAssessment> ;
                                                   rdfs:range <http://example.org/kg-mnp#BlockingReason> .


###  http://example.org/kg-mnp#producesDecision
<http://example.org/kg-mnp#producesDecision> rdf:type owl:ObjectProperty ;
                                             rdfs:domain <http://example.org/kg-mnp#EligibilityAssessment> ;
                                             rdfs:range <http://example.org/kg-mnp#EligibilityDecision> .


###  http://example.org/kg-mnp#recommendsAction
<http://example.org/kg-mnp#recommendsAction> rdf:type owl:ObjectProperty ;
                                             rdfs:domain <http://example.org/kg-mnp#BlockingReason> ;
                                             rdfs:range <http://example.org/kg-mnp#RemediationAction> .


###  http://example.org/kg-mnp#relatedAccount
<http://example.org/kg-mnp#relatedAccount> rdf:type owl:ObjectProperty ;
                                           rdfs:domain <http://example.org/kg-mnp#Subscriber> ;
                                           rdfs:range <http://example.org/kg-mnp#TelecomAccount> .


###  http://example.org/kg-mnp#requestedBy
<http://example.org/kg-mnp#requestedBy> rdf:type owl:ObjectProperty ;
                                        rdfs:domain <http://example.org/kg-mnp#MNPCase> ;
                                        rdfs:range <http://example.org/kg-mnp#Subscriber> .


###  http://example.org/kg-mnp#subscribesToService
<http://example.org/kg-mnp#subscribesToService> rdf:type owl:ObjectProperty ;
                                                rdfs:domain <http://example.org/kg-mnp#ServiceSubscription> ;
                                                rdfs:range <http://example.org/kg-mnp#TelecomService> .


###  http://example.org/kg-mnp#supersedesRuleVersion
<http://example.org/kg-mnp#supersedesRuleVersion> rdf:type owl:ObjectProperty ;
                                                  rdfs:domain <http://example.org/kg-mnp#RuleVersion> ;
                                                  rdfs:range <http://example.org/kg-mnp#RuleVersion> ;
                                                  rdfs:comment "Links a newer rule version to the older version it supersedes."@en .


###  http://example.org/kg-mnp#supportedByEvidence
<http://example.org/kg-mnp#supportedByEvidence> rdf:type owl:ObjectProperty ;
                                                rdfs:domain <http://example.org/kg-mnp#BlockingReason> ;
                                                rdfs:range <http://example.org/kg-mnp#EvidenceRecord> .


###  http://example.org/kg-mnp#triggeredByRule
<http://example.org/kg-mnp#triggeredByRule> rdf:type owl:ObjectProperty ;
                                            rdfs:domain <http://example.org/kg-mnp#BlockingReason> ;
                                            rdfs:range <http://example.org/kg-mnp#EligibilityRule> .


###  http://example.org/kg-mnp#triggeredByRuleVersion
<http://example.org/kg-mnp#triggeredByRuleVersion> rdf:type owl:ObjectProperty ;
                                                   rdfs:domain <http://example.org/kg-mnp#BlockingReason> ;
                                                   rdfs:range <http://example.org/kg-mnp#RuleVersion> .


###  http://example.org/kg-mnp#usesEvidence
<http://example.org/kg-mnp#usesEvidence> rdf:type owl:ObjectProperty ;
                                         rdfs:domain <http://example.org/kg-mnp#EligibilityAssessment> ;
                                         rdfs:range <http://example.org/kg-mnp#EvidenceRecord> .


###  http://example.org/kg-mnp#usesRuleVersion
<http://example.org/kg-mnp#usesRuleVersion> rdf:type owl:ObjectProperty ;
                                            rdfs:domain <http://example.org/kg-mnp#EligibilityAssessment> ;
                                            rdfs:range <http://example.org/kg-mnp#RuleVersion> .


