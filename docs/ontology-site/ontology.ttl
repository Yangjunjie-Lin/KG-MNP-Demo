<http://example.org/kg-mnp#caseIdentifier> rdf:type owl:DatatypeProperty ;
                                           rdfs:domain <http://example.org/kg-mnp#MNPCase> ;
                                           rdfs:range xsd:string .


###  http://example.org/kg-mnp#clauseIdentifier
<http://example.org/kg-mnp#clauseIdentifier> rdf:type owl:DatatypeProperty ;
                                             rdfs:domain <http://example.org/kg-mnp#RegulatoryClause> ;
                                             rdfs:range xsd:string .


###  http://example.org/kg-mnp#clauseText
<http://example.org/kg-mnp#clauseText> rdf:type owl:DatatypeProperty ;
                                       rdfs:domain <http://example.org/kg-mnp#RegulatoryClause> ;
                                       rdfs:range xsd:string .


###  http://example.org/kg-mnp#contractEndTime
<http://example.org/kg-mnp#contractEndTime> rdf:type owl:DatatypeProperty ;
                                            rdfs:domain <http://example.org/kg-mnp#ServiceContract> ;
                                            rdfs:range xsd:dateTime .


###  http://example.org/kg-mnp#contractStatusCode
<http://example.org/kg-mnp#contractStatusCode> rdf:type owl:DatatypeProperty ;
                                               rdfs:domain <http://example.org/kg-mnp#ServiceContract> ;
                                               rdfs:range xsd:string .


###  http://example.org/kg-mnp#currencyCode
<http://example.org/kg-mnp#currencyCode> rdf:type owl:DatatypeProperty ;
                                         rdfs:domain <http://example.org/kg-mnp#EvidenceRecord> ;
                                         rdfs:range xsd:string .


###  http://example.org/kg-mnp#daysSinceLastPort
<http://example.org/kg-mnp#daysSinceLastPort> rdf:type owl:DatatypeProperty ;
                                              rdfs:domain <http://example.org/kg-mnp#EvidenceRecord> ;
                                              rdfs:range xsd:integer .


###  http://example.org/kg-mnp#decisionCode
<http://example.org/kg-mnp#decisionCode> rdf:type owl:DatatypeProperty ;
                                         rdfs:domain <http://example.org/kg-mnp#EligibilityDecision> ;
                                         rdfs:range xsd:string .


###  http://example.org/kg-mnp#documentIdentifier
<http://example.org/kg-mnp#documentIdentifier> rdf:type owl:DatatypeProperty ;
                                               rdfs:domain <http://example.org/kg-mnp#RegulatoryDocument> ;
                                               rdfs:range xsd:string .


###  http://example.org/kg-mnp#effectiveFrom
<http://example.org/kg-mnp#effectiveFrom> rdf:type owl:DatatypeProperty ;
                                          rdfs:range xsd:dateTime .


###  http://example.org/kg-mnp#effectiveTo
<http://example.org/kg-mnp#effectiveTo> rdf:type owl:DatatypeProperty ;
                                        rdfs:range xsd:dateTime .


###  http://example.org/kg-mnp#evidenceGeneratedAt
<http://example.org/kg-mnp#evidenceGeneratedAt> rdf:type owl:DatatypeProperty ;
                                                rdfs:domain <http://example.org/kg-mnp#EvidenceRecord> ;
                                                rdfs:range xsd:dateTime .


###  http://example.org/kg-mnp#evidenceStatus
<http://example.org/kg-mnp#evidenceStatus> rdf:type owl:DatatypeProperty ;
                                           rdfs:domain <http://example.org/kg-mnp#EvidenceRecord> ;
                                           rdfs:range xsd:string .


###  http://example.org/kg-mnp#evidenceType
<http://example.org/kg-mnp#evidenceType> rdf:type owl:DatatypeProperty ;
                                         rdfs:domain <http://example.org/kg-mnp#EvidenceRecord> ;
                                         rdfs:range xsd:string .


###  http://example.org/kg-mnp#evidenceValidUntil
<http://example.org/kg-mnp#evidenceValidUntil> rdf:type owl:DatatypeProperty ;
                                               rdfs:domain <http://example.org/kg-mnp#EvidenceRecord> ;
                                               rdfs:range xsd:dateTime .


###  http://example.org/kg-mnp#hasPaymentArrangement
<http://example.org/kg-mnp#hasPaymentArrangement> rdf:type owl:DatatypeProperty ;
                                                  rdfs:domain <http://example.org/kg-mnp#EvidenceRecord> ;
                                                  rdfs:range xsd:boolean .


###  http://example.org/kg-mnp#identityMatchFlag
<http://example.org/kg-mnp#identityMatchFlag> rdf:type owl:DatatypeProperty ;
                                              rdfs:domain <http://example.org/kg-mnp#EvidenceRecord> ;
                                              rdfs:range xsd:boolean .


###  http://example.org/kg-mnp#mappingReviewStatus
<http://example.org/kg-mnp#mappingReviewStatus> rdf:type owl:DatatypeProperty ;
                                                rdfs:domain <http://example.org/kg-mnp#MappingRecord> ;
                                                rdfs:range xsd:string .


###  http://example.org/kg-mnp#maskedPhoneNumber
<http://example.org/kg-mnp#maskedPhoneNumber> rdf:type owl:DatatypeProperty ;
                                              rdfs:domain <http://example.org/kg-mnp#PhoneNumber> ;
                                              rdfs:range xsd:string .


###  http://example.org/kg-mnp#numberStatusCode
<http://example.org/kg-mnp#numberStatusCode> rdf:type owl:DatatypeProperty ;
                                             rdfs:domain <http://example.org/kg-mnp#EvidenceRecord> ;
                                             rdfs:range xsd:string .


###  http://example.org/kg-mnp#observedAmount
<http://example.org/kg-mnp#observedAmount> rdf:type owl:DatatypeProperty ;
                                           rdfs:domain <http://example.org/kg-mnp#EvidenceRecord> ;
                                           rdfs:range xsd:decimal .


###  http://example.org/kg-mnp#reasonCode
<http://example.org/kg-mnp#reasonCode> rdf:type owl:DatatypeProperty ;
                                       rdfs:domain <http://example.org/kg-mnp#BlockingReason> ;
                                       rdfs:range xsd:string .


###  http://example.org/kg-mnp#reasonDescription
<http://example.org/kg-mnp#reasonDescription> rdf:type owl:DatatypeProperty ;
                                              rdfs:domain <http://example.org/kg-mnp#BlockingReason> ;
                                              rdfs:range xsd:string .


###  http://example.org/kg-mnp#reassessmentReason
<http://example.org/kg-mnp#reassessmentReason> rdf:type owl:DatatypeProperty ;
                                               rdfs:domain <http://example.org/kg-mnp#ReassessmentMarker> ;
                                               rdfs:range xsd:string .


###  http://example.org/kg-mnp#requiresReassessment
<http://example.org/kg-mnp#requiresReassessment> rdf:type owl:DatatypeProperty ;
                                                 rdfs:domain <http://example.org/kg-mnp#EligibilityAssessment> ;
                                                 rdfs:range xsd:boolean .


###  http://example.org/kg-mnp#ruleIdentifier
<http://example.org/kg-mnp#ruleIdentifier> rdf:type owl:DatatypeProperty ;
                                           rdfs:domain <http://example.org/kg-mnp#EligibilityRule> ;
                                           rdfs:range xsd:string .


###  http://example.org/kg-mnp#ruleVersion
<http://example.org/kg-mnp#ruleVersion> rdf:type owl:DatatypeProperty ;
                                        rdfs:range xsd:string .


###  http://example.org/kg-mnp#sourceApi
<http://example.org/kg-mnp#sourceApi> rdf:type owl:DatatypeProperty ;
                                      rdfs:domain <http://example.org/kg-mnp#MappingRecord> ;
                                      rdfs:range xsd:string .


###  http://example.org/kg-mnp#sourceFieldPath
<http://example.org/kg-mnp#sourceFieldPath> rdf:type owl:DatatypeProperty ;
                                            rdfs:domain <http://example.org/kg-mnp#MappingRecord> ;
                                            rdfs:range xsd:string .


###  http://example.org/kg-mnp#subscriptionStatusCode
<http://example.org/kg-mnp#subscriptionStatusCode> rdf:type owl:DatatypeProperty ;
                                                   rdfs:domain <http://example.org/kg-mnp#ServiceSubscription> ;
                                                   rdfs:range xsd:string .


###  http://example.org/kg-mnp#systemIdentifier
<http://example.org/kg-mnp#systemIdentifier> rdf:type owl:DatatypeProperty ;
                                             rdfs:domain <http://example.org/kg-mnp#InformationSystem> ;
                                             rdfs:range xsd:string .


###  http://example.org/kg-mnp#targetTerm
<http://example.org/kg-mnp#targetTerm> rdf:type owl:DatatypeProperty ;
                                       rdfs:domain <http://example.org/kg-mnp#MappingRecord> ;
                                       rdfs:range xsd:string .


#################################################################
#    Classes
#################################################################

###  http://example.org/kg-mnp#AssessmentDependency
<http://example.org/kg-mnp#AssessmentDependency> rdf:type owl:Class ;
                                                 <http://example.org/kg-mnp#alignmentStatus> "LOCAL_ONLY" ;
                                                 rdfs:comment "A dependency link from an assessment to a rule version or evidence set used."@en ;
                                                 rdfs:label "Assessment Dependency"@en .


###  http://example.org/kg-mnp#BlockingDecision
<http://example.org/kg-mnp#BlockingDecision> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://example.org/kg-mnp#EligibilityDecision> ;
                                             owl:disjointWith <http://example.org/kg-mnp#ConditionalDecision> ,
                                                              <http://example.org/kg-mnp#EligibleDecision> ,
                                                              <http://example.org/kg-mnp#ManualReviewDecision> ;
                                             <http://example.org/kg-mnp#alignmentStatus> "LOCAL_ONLY" ;
                                             rdfs:label "Blocking Decision"@en .


###  http://example.org/kg-mnp#BlockingReason
<http://example.org/kg-mnp#BlockingReason> rdf:type owl:Class ;
                                           <http://example.org/kg-mnp#alignmentStatus> "LOCAL_ONLY" ;
                                           rdfs:comment "An independent reason that contributes to a blocking or review outcome."@en ;
                                           rdfs:label "Blocking Reason"@en .


###  http://example.org/kg-mnp#ConditionalDecision
<http://example.org/kg-mnp#ConditionalDecision> rdf:type owl:Class ;
                                                rdfs:subClassOf <http://example.org/kg-mnp#EligibilityDecision> ;
                                                owl:disjointWith <http://example.org/kg-mnp#EligibleDecision> ,
                                                                 <http://example.org/kg-mnp#ManualReviewDecision> ;
                                                <http://example.org/kg-mnp#alignmentStatus> "LOCAL_ONLY" ;
                                                rdfs:label "Conditional Decision"@en .


###  http://example.org/kg-mnp#EligibilityAssessment
<http://example.org/kg-mnp#EligibilityAssessment> rdf:type owl:Class ;
                                                  rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <http://example.org/kg-mnp#dependsOn> ;
                                                                    owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <http://example.org/kg-mnp#evaluatedByRule> ;
                                                                    owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <http://example.org/kg-mnp#usesEvidence> ;
                                                                    owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                                  ] ,
                                                                  [ rdf:type owl:Restriction ;
                                                                    owl:onProperty <http://example.org/kg-mnp#producesDecision> ;
                                                                    owl:cardinality "1"^^xsd:nonNegativeInteger
                                                                  ] ;
                                                  <http://example.org/kg-mnp#alignmentStatus> "LOCAL_ONLY" ;
                                                  <http://purl.org/dc/terms/source> "Local evidence-rule-decision assessment concept." ;
                                                  rdfs:comment "A deterministic evaluation of an MNP case against eligibility rules and evidence."@en ;
                                                  rdfs:label "Eligibility Assessment"@en .


###  http://example.org/kg-mnp#EligibilityDecision
<http://example.org/kg-mnp#EligibilityDecision> rdf:type owl:Class ;
                                                <http://example.org/kg-mnp#alignmentStatus> "LOCAL_ONLY" ;
                                                <http://purl.org/dc/terms/source> "Local decision taxonomy." ;
                                                rdfs:comment "Abstract decision outcome of an eligibility assessment."@en ;
                                                rdfs:label "Eligibility Decision"@en .


###  http://example.org/kg-mnp#EligibilityRule
<http://example.org/kg-mnp#EligibilityRule> rdf:type owl:Class ;
                                            rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                              owl:onProperty <http://example.org/kg-mnp#operationalizesClause> ;
                                                              owl:minCardinality "1"^^xsd:nonNegativeInteger
                                                            ] ;
                                            <http://example.org/kg-mnp#alignmentStatus> "LOCAL_ONLY" ;
                                            rdfs:comment "A versioned eligibility rule operationalizing regulatory clauses."@en ;
                                            rdfs:label "Eligibility Rule"@en .


###  http://example.org/kg-mnp#EligibleDecision
<http://example.org/kg-mnp#EligibleDecision> rdf:type owl:Class ;
                                             rdfs:subClassOf <http://example.org/kg-mnp#EligibilityDecision> ;
                                             owl:disjointWith <http://example.org/kg-mnp#ManualReviewDecision> ;
                                             <http://example.org/kg-mnp#alignmentStatus> "LOCAL_ONLY" ;
                                             rdfs:label "Eligible Decision"@en .


###  http://example.org/kg-mnp#EvidenceRecord
<http://example.org/kg-mnp#EvidenceRecord> rdf:type owl:Class ;
                                           <http://example.org/kg-mnp#alignmentStatus> "PARTIAL" ;
                                           <http://purl.org/dc/terms/source> "Conceptually compared with CTO MeasurementRecord (observation with magnitude/aspect). Different purpose: MNP evidence includes provenance, validity window, and status." ;
                                           rdfs:comment "A dated observation used as evidence in eligibility assessment."@en ,
                                                        "Not skos:closeMatch — MeasurementRecord is quantitative measurement; EvidenceRecord is eligibility provenance."@en ;
                                           rdfs:label "Evidence Record"@en ;
                                           rdfs:seeAlso <https://github.com/Point-Topic/cto-ontology/blob/main/resource/cto_core.ttl> .


