#    Data properties
#################################################################

###  http://example.org/kg-mnp#actionCode
<http://example.org/kg-mnp#actionCode> rdf:type owl:DatatypeProperty ;
                                       rdfs:domain <http://example.org/kg-mnp#RemediationAction> ;
                                       rdfs:range xsd:string .


###  http://example.org/kg-mnp#actionDescription
<http://example.org/kg-mnp#actionDescription> rdf:type owl:DatatypeProperty ;
                                              rdfs:domain <http://example.org/kg-mnp#RemediationAction> ;
                                              rdfs:range xsd:string .


###  http://example.org/kg-mnp#assessmentIdentifier
<http://example.org/kg-mnp#assessmentIdentifier> rdf:type owl:DatatypeProperty ;
                                                 rdfs:domain <http://example.org/kg-mnp#EligibilityAssessment> ;
                                                 rdfs:range xsd:string .


