###  http://example.org/kg-mnp#MNPCase
<http://example.org/kg-mnp#MNPCase> rdf:type owl:Class ;
                                    rdfs:subClassOf [ rdf:type owl:Restriction ;
                                                      owl:onProperty <http://example.org/kg-mnp#concernsNumber> ;
                                                      owl:cardinality "1"^^xsd:nonNegativeInteger
                                                    ] ,
                                                    [ rdf:type owl:Restriction ;
                                                      owl:onProperty <http://example.org/kg-mnp#requestedBy> ;
                                                      owl:cardinality "1"^^xsd:nonNegativeInteger
                                                    ] ;
                                    <http://example.org/kg-mnp#alignmentStatus> "LOCAL_ONLY" ;
                                    <http://purl.org/dc/terms/source> "Local MNP case concept; not present in CTO or TM Forum as OWL class." ;
                                    rdfs:comment "A mobile number portability request case."@en ;
                                    rdfs:label "MNP Case"@en .


