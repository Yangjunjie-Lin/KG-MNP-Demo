@prefix mnp: <https://yangjunjie-lin.github.io/KG-MNP-Demo/ontology/terms#> .
@prefix data: <https://yangjunjie-lin.github.io/KG-MNP-Demo/data/> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# CASE-06: historical assessment used rule MNP-ELIG-005 v1.0;
# after update to 1.1, query must locate affected assessments.

data:Sub-06 a mnp:Subscriber ;
    mnp:holdsSubscription data:Subscr-06  .
data:Phone-06 a mnp:PhoneNumber ;
    mnp:assignedToSubscription data:Subscr-06 ;
    mnp:maskedPhoneNumber "138****0006" .

data:Acct-06 a mnp:TelecomAccount .

data:Subscr-06 a mnp:ServiceSubscription ;
    mnp:billedThrough data:Acct-06 ;
    mnp:subscribesToService data:Svc-Mobile-Basic ;
    mnp:subscriptionStatusCode "ACTIVE" ;
    mnp:governedByContract data:Contract-06 .

data:Contract-06 a mnp:ServiceContract ;
    mnp:contractStatusCode "EXPIRED" ;
    mnp:contractEndTime "2025-03-01T00:00:00Z"^^xsd:dateTime .

data:CASE-06 a mnp:MNPCase ;
    mnp:caseIdentifier "CASE-06" ;
    mnp:concernsNumber data:Phone-06 ;
    mnp:requestedBy data:Sub-06 ;
    mnp:hasCaseEvidence
        data:Ev-06-ID ,
        data:Ev-06-NUM ,
        data:Ev-06-BILL ,
        data:Ev-06-CTR ,
        data:Ev-06-PORT .

data:Ev-06-ID a mnp:SystemObservation ;
    mnp:evidenceType "IDENTITY_MATCH" ;
    mnp:identityMatchFlag true ;
    mnp:evidenceStatus "VALID" ;
    mnp:evidenceGeneratedAt "2026-05-15T10:00:00Z"^^xsd:dateTime ;
    mnp:evidenceValidUntil "2026-12-31T23:59:59Z"^^xsd:dateTime ;
    mnp:hasSourceSystem data:SYS-CRM .

data:Ev-06-NUM a mnp:SystemObservation ;
    mnp:evidenceType "NUMBER_STATUS" ;
    mnp:numberStatusCode "ACTIVE" ;
    mnp:evidenceStatus "VALID" ;
    mnp:evidenceGeneratedAt "2026-05-15T10:05:00Z"^^xsd:dateTime ;
    mnp:evidenceValidUntil "2026-12-31T23:59:59Z"^^xsd:dateTime ;
    mnp:hasSourceSystem data:SYS-HLR .

data:Ev-06-BILL a mnp:SystemObservation ;
    mnp:evidenceType "BILLING_BALANCE" ;
    mnp:observedAmount "0.00"^^xsd:decimal ;
    mnp:currencyCode "CNY" ;
    mnp:hasPaymentArrangement false ;
    mnp:evidenceStatus "VALID" ;
    mnp:evidenceGeneratedAt "2026-05-15T10:10:00Z"^^xsd:dateTime ;
    mnp:evidenceValidUntil "2026-12-31T23:59:59Z"^^xsd:dateTime ;
    mnp:hasSourceSystem data:SYS-BILLING .

data:Ev-06-CTR a mnp:SystemObservation ;
    mnp:evidenceType "CONTRACT_STATUS" ;
    mnp:contractStatusCode "EXPIRED" ;
    mnp:contractEndTime "2025-03-01T00:00:00Z"^^xsd:dateTime ;
    mnp:evidenceStatus "VALID" ;
    mnp:evidenceGeneratedAt "2026-05-15T10:15:00Z"^^xsd:dateTime ;
    mnp:evidenceValidUntil "2026-12-31T23:59:59Z"^^xsd:dateTime ;
    mnp:hasSourceSystem data:SYS-CONTRACT .

# 150 days: passes v1.0 (min 120) but fails v1.1 (min 180)
data:Ev-06-PORT a mnp:SystemObservation ;
    mnp:evidenceType "PORTING_HISTORY" ;
    mnp:daysSinceLastPort 150 ;
    mnp:evidenceStatus "VALID" ;
    mnp:evidenceGeneratedAt "2026-05-15T10:20:00Z"^^xsd:dateTime ;
    mnp:evidenceValidUntil "2026-12-31T23:59:59Z"^^xsd:dateTime ;
    mnp:hasSourceSystem data:SYS-MNP .

# Pre-seeded historical assessment using rule version 1.0
# assessmentTime falls in MNP-ELIG-005 v1.0 window (before 2026-06-01).
data:Assessment-CASE-06-HIST a mnp:EligibilityAssessment ;
    mnp:assessmentIdentifier "ASSESS-CASE-06-HIST" ;
    mnp:assessmentTime "2026-05-15T12:00:00Z"^^xsd:dateTime ;
    mnp:aboutCase data:CASE-06 ;
    mnp:usesEvidence data:Ev-06-ID , data:Ev-06-NUM , data:Ev-06-BILL , data:Ev-06-CTR , data:Ev-06-PORT ;
    mnp:evaluatedByRule data:Rule-MNP-ELIG-001 , data:Rule-MNP-ELIG-002 , data:Rule-MNP-ELIG-003 , data:Rule-MNP-ELIG-004 , data:Rule-MNP-ELIG-005 ;
    mnp:usesRuleVersion data:RuleVersion-MNP-ELIG-005-1-0 ;
    mnp:producesDecision data:Decision-CASE-06-HIST ;
    mnp:requiresReassessment true .

data:Decision-CASE-06-HIST a mnp:EligibleDecision ;
    mnp:decisionCode "ELIGIBLE" .

data:CASE-06 mnp:hasEligibilityAssessment data:Assessment-CASE-06-HIST .
