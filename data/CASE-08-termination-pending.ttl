@prefix mnp: <http://example.org/kg-mnp#> .
@prefix rdfs: <http://www.w3.org/2000/01/rdf-schema#> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

# CASE-08: all conditions satisfied → ELIGIBLE

mnp:Sub-08 a mnp:Subscriber ;
    rdfs:label "Subscriber 08" ;
    mnp:ownsPhoneNumber mnp:Phone-08 ;
    mnp:billedThrough mnp:Acct-08 ;
    mnp:hasSubscription mnp:Subscr-08 ;
    mnp:relatedAccount mnp:Acct-08 .

mnp:Phone-08 a mnp:PhoneNumber ;
    mnp:maskedPhoneNumber "138****0008" .

mnp:Acct-08 a mnp:TelecomAccount ;
    rdfs:label "Account 08" .

mnp:Svc-Mobile-Basic a mnp:TelecomService ;
    rdfs:label "Mobile Basic Plan" .

mnp:Subscr-08 a mnp:ServiceSubscription ;
    mnp:subscribesToService mnp:Svc-Mobile-Basic ;
    mnp:subscriptionStatusCode "ACTIVE" ;
    mnp:governedByContract mnp:Contract-08 .

mnp:Contract-08 a mnp:ServiceContract ;
    mnp:contractStatusCode "ACTIVE" ;
    mnp:contractEndTime "2027-06-01T00:00:00Z"^^xsd:dateTime .

mnp:CASE-08 a mnp:MNPCase ;
    mnp:caseIdentifier "CASE-08" ;
    mnp:concernsNumber mnp:Phone-08 ;
    mnp:requestedBy mnp:Sub-08 ;
    mnp:hasCaseEvidence
        mnp:Ev-08-ID ,
        mnp:Ev-08-NUM ,
        mnp:Ev-08-BILL ,
        mnp:Ev-08-CTR ,
        mnp:Ev-08-PORT .

mnp:Ev-08-ID a mnp:SystemObservation ;
    mnp:evidenceType "IDENTITY_MATCH" ;
    mnp:identityMatchFlag true ;
    mnp:evidenceStatus "VALID" ;
    mnp:evidenceGeneratedAt "2026-06-20T10:00:00Z"^^xsd:dateTime ;
    mnp:evidenceValidUntil "2026-12-31T23:59:59Z"^^xsd:dateTime ;
    mnp:hasSourceSystem mnp:SYS-CRM .

mnp:Ev-08-NUM a mnp:SystemObservation ;
    mnp:evidenceType "NUMBER_STATUS" ;
    mnp:numberStatusCode "ACTIVE" ;
    mnp:evidenceStatus "VALID" ;
    mnp:evidenceGeneratedAt "2026-06-20T10:05:00Z"^^xsd:dateTime ;
    mnp:evidenceValidUntil "2026-12-31T23:59:59Z"^^xsd:dateTime ;
    mnp:hasSourceSystem mnp:SYS-HLR .

mnp:Ev-08-BILL a mnp:SystemObservation ;
    mnp:evidenceType "BILLING_BALANCE" ;
    mnp:observedAmount "0.00"^^xsd:decimal ;
    mnp:currencyCode "CNY" ;
    mnp:hasPaymentArrangement false ;
    mnp:evidenceStatus "VALID" ;
    mnp:evidenceGeneratedAt "2026-06-20T10:10:00Z"^^xsd:dateTime ;
    mnp:evidenceValidUntil "2026-12-31T23:59:59Z"^^xsd:dateTime ;
    mnp:hasSourceSystem mnp:SYS-BILLING .

mnp:Ev-08-CTR a mnp:SystemObservation ;
    mnp:evidenceType "CONTRACT_STATUS" ;
    mnp:contractStatusCode "ACTIVE" ;
    mnp:contractEndTime "2027-06-01T00:00:00Z"^^xsd:dateTime ;
    mnp:evidenceStatus "VALID" ;
    mnp:evidenceGeneratedAt "2026-06-20T10:15:00Z"^^xsd:dateTime ;
    mnp:evidenceValidUntil "2026-12-31T23:59:59Z"^^xsd:dateTime ;
    mnp:hasSourceSystem mnp:SYS-CONTRACT .

mnp:Ev-08-PORT a mnp:SystemObservation ;
    mnp:evidenceType "PORTING_HISTORY" ;
    mnp:daysSinceLastPort 400 ;
    mnp:evidenceStatus "VALID" ;
    mnp:evidenceGeneratedAt "2026-06-20T10:20:00Z"^^xsd:dateTime ;
    mnp:evidenceValidUntil "2026-12-31T23:59:59Z"^^xsd:dateTime ;
    mnp:hasSourceSystem mnp:SYS-MNP .


mnp:Termination-08 a mnp:TerminationAgreement ;
    mnp:terminationSignedAt "2026-06-20T00:00:00Z"^^xsd:dateTime ;
    mnp:terminationEffectiveAt "2026-08-01T00:00:00Z"^^xsd:dateTime ;
    mnp:terminationStatusCode "SIGNED_PENDING_EFFECTIVE" .

mnp:Contract-08 mnp:hasTerminationAgreement mnp:Termination-08 .

